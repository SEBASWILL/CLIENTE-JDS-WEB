---
import QRCode from 'qrcode';
import { Image } from 'astro:assets';
import logo from '../../assets/logo.jpeg';
import { APP_DOWNLOAD_URL, APP_NAME } from '../../config';

// El QR se genera al compilar, como SVG, a partir del enlace de src/config.ts.
const qrSvg = await QRCode.toString(APP_DOWNLOAD_URL, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'H', // permite poner el logo encima sin que deje de leerse
  color: { dark: '#0A0F1E', light: '#FFFFFF' },
});
---
<section id="descarga" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-20">
    <div class="relative overflow-hidden rounded-3xl bg-cashly-fondo px-6 py-12 ring-1 ring-borde sm:px-12">
      <div class="pointer-events-none absolute -right-24 -bottom-24 h-80 w-80 rounded-full bg-brand-cian/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-brand/20 blur-3xl"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold text-brand-cian">App móvil</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight">Lleva {APP_NAME} en tu bolsillo</h2>
          <p class="mt-3 max-w-md text-texto-2">
            Revisa tu resumen, tus reportes y tus metas desde el celular. Escanea el código con la cámara
            de tu teléfono para descargar la app.
          </p>

          <ul class="mt-6 space-y-2 text-sm text-texto-2">
            <li><span class="text-brand-cian">✓</span> La misma cuenta de la web</li>
            <li><span class="text-brand-cian">✓</span> Tus gastos sincronizados al instante</li>
            <li><span class="text-brand-cian">✓</span> Registra pagos en efectivo donde estés</li>
          </ul>

          <a
            href={APP_DOWNLOAD_URL}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-block rounded-xl bg-cashly px-5 py-3 font-semibold text-white shadow-lg shadow-brand/30 transition hover:opacity-90"
          >
            Descargar la app
          </a>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="rounded-3xl bg-white p-5 text-center shadow-2xl shadow-brand/20">
            <div class="relative h-48 w-48 sm:h-56 sm:w-56">
              <div class="h-full w-full [&>svg]:h-full [&>svg]:w-full" set:html={qrSvg} />
              <Image
                src={logo}
                alt=""
                width={96}
                height={96}
                class="absolute top-1/2 left-1/2 h-11 w-11 -translate-x-1/2 -translate-y-1/2 rounded-xl ring-4 ring-white"
              />
            </div>
            <p class="mt-3 text-sm font-semibold text-[#0E1525]">📷 Escanéame</p>
            <p class="text-xs text-[#6B7385]">Abre la cámara y apunta al código</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
