---
// Logo de Cashly (ícono + nombre). Astro optimiza la imagen al compilar.
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';
import { APP_NAME } from '../config';

interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2 font-bold tracking-tight', className]}>
  <Image src={logo} alt="" width={size * 2} height={size * 2} style={`width:${size}px;height:${size}px`} class="rounded-lg" />
  <span>{APP_NAME}</span>
</span>
