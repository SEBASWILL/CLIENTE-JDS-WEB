---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gastos</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">

    <!-- ============ LOGIN / REGISTRO ============ -->
    <main id="auth" class="hidden min-h-screen items-center justify-center p-4">
      <form id="auth-form" class="w-full max-w-sm space-y-4 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200">
        <div>
          <h1 class="text-2xl font-bold">💸 Gastos</h1>
          <p id="auth-sub" class="text-sm text-slate-500">Inicia sesión para ver tus gastos</p>
        </div>
        <input id="a-email" type="email" required placeholder="correo@ejemplo.com" class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-emerald-500" />
        <input id="a-rk" placeholder="Llave de recuperación" autocomplete="off" class="hidden w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm outline-none focus:border-emerald-500" />
        <input id="a-pass" type="password" required minlength="10" placeholder="Contraseña (mínimo 10 caracteres)" class="w-full rounded-lg border border-slate-300 px-3 py-2 outline-none focus:border-emerald-500" />
        <button id="a-submit" class="w-full rounded-lg bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-700">Entrar</button>
        <button type="button" id="a-toggle" class="w-full text-sm text-emerald-700 hover:underline">¿No tienes cuenta? Crear una</button>
        <button type="button" id="a-forgot" class="w-full text-xs text-slate-500 hover:underline">¿Olvidaste la contraseña o perdiste el celular?</button>
        <label class="block border-t pt-3 text-xs text-slate-500">
          URL de la API
          <input id="a-api" class="mt-1 w-full rounded border border-slate-200 px-2 py-1 font-mono text-xs" />
        </label>
      </form>

      <!-- Verificación del correo: código de 6 dígitos enviado al registrarse -->
      <form id="email-form" class="hidden w-full max-w-sm space-y-4 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200">
        <div>
          <h1 class="text-2xl font-bold">📧 Verifica tu correo</h1>
          <p class="text-sm text-slate-500">Te enviamos un código de 6 dígitos a <b id="ev-email" class="break-all text-slate-700"></b>. Vence en 10 minutos.</p>
        </div>
        <p id="ev-warn" class="hidden rounded-lg bg-amber-50 p-2 text-xs text-amber-800 ring-1 ring-amber-200"></p>
        <input id="ev-code" required inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="123 456"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-center font-mono text-2xl tracking-widest outline-none focus:border-emerald-500" />
        <button id="ev-submit" class="w-full rounded-lg bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-700 disabled:opacity-60">Verificar correo</button>
        <button type="button" id="ev-resend" class="w-full rounded-lg border py-2 text-sm hover:bg-slate-100 disabled:cursor-not-allowed disabled:text-slate-400 disabled:hover:bg-transparent">Reenviar código</button>
        <p class="text-xs text-slate-400">¿No lo ves? Revisa la carpeta de spam o promociones.</p>
        <button type="button" id="ev-cancel" class="w-full text-sm text-slate-500 hover:underline">Cancelar y volver</button>
      </form>

      <!-- Segundo paso: código del Authenticator (y QR si aún no lo configuró) -->
      <form id="mfa-form" class="hidden w-full max-w-sm space-y-4 rounded-2xl bg-white p-6 shadow-lg ring-1 ring-slate-200">
        <div>
          <h1 class="text-2xl font-bold">🔐 Verificación</h1>
          <p id="mfa-sub" class="text-sm text-slate-500">Escribe el código de 6 dígitos de tu app Authenticator.</p>
        </div>
        <div id="mfa-setup" class="hidden space-y-3">
          <ol class="list-decimal space-y-1 pl-5 text-sm text-slate-600">
            <li>Abre Microsoft Authenticator (o Google Authenticator).</li>
            <li>Toca <b>+</b> → <b>Otra cuenta</b> y escanea este código.</li>
            <li>Escribe abajo el código de 6 dígitos que aparece.</li>
          </ol>
          <img id="mfa-qr" alt="Código QR para el Authenticator" class="mx-auto h-48 w-48 rounded-lg ring-1 ring-slate-200" />
          <details class="text-xs text-slate-500">
            <summary class="cursor-pointer">¿No puedes escanear? Escribe la clave a mano</summary>
            <div class="mt-2 flex items-center gap-2">
              <code id="mfa-secret" class="flex-1 break-all rounded bg-slate-100 p-2 font-mono"></code>
              <button type="button" id="mfa-secret-copy" class="rounded border px-2 py-1 hover:bg-slate-100">Copiar</button>
            </div>
          </details>
        </div>
        <input id="mfa-code" required inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="123 456"
          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-center font-mono text-2xl tracking-widest outline-none focus:border-emerald-500" />
        <button class="w-full rounded-lg bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-700">Verificar</button>
        <button type="button" id="mfa-cancel" class="w-full text-sm text-slate-500 hover:underline">Cancelar y volver</button>
      </form>
    </main>

    <!-- ============ APP ============ -->
    <div id="app" class="hidden">
      <header class="border-b bg-white">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
          <h1 class="text-lg font-bold">💸 Gastos</h1>
          <div class="flex items-center gap-3 text-sm">
            <button id="api-url" class="hidden rounded bg-slate-100 px-2 py-1 font-mono text-xs text-slate-500 hover:bg-slate-200 sm:block" title="Cambiar URL de la API"></button>
            <button id="logout" class="rounded-lg border px-3 py-1.5 hover:bg-slate-100">Salir</button>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-5xl space-y-6 p-4">
        <nav class="flex gap-1 rounded-xl bg-slate-200 p-1 text-sm font-medium">
          <button data-tab="resumen" class="flex-1 rounded-lg px-3 py-2">📊 Resumen</button>
          <button data-tab="reportes" class="flex-1 rounded-lg px-3 py-2">📅 Reportes</button>
          <button data-tab="metas" class="flex-1 rounded-lg px-3 py-2">🎯 Metas</button>
        </nav>
        <div id="demo-note" class="hidden rounded-xl bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-amber-200">
          Mostrando <b>datos de ejemplo</b>: la API aún no tiene estos endpoints.
          <button id="demo-retry" class="font-semibold underline">Reintentar con la API real</button>
        </div>

        <div id="tab-resumen" class="space-y-6">
        <!-- Resumen -->
        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          <div class="rounded-2xl bg-emerald-600 p-4 text-white shadow">
            <p class="text-xs uppercase opacity-80">Total gastado</p>
            <p id="k-total" class="mt-1 text-2xl font-bold">–</p>
          </div>
          <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs uppercase text-slate-500">Movimientos</p>
            <p id="k-count" class="mt-1 text-2xl font-bold">–</p>
            <p class="text-xs text-rose-600"><span id="k-declined">0</span> declinadas</p>
          </div>
          <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs uppercase text-slate-500">💳 Tarjeta</p>
            <p id="k-card" class="mt-1 text-2xl font-bold">–</p>
          </div>
          <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs uppercase text-slate-500">💵 Efectivo</p>
            <p id="k-cash" class="mt-1 text-2xl font-bold">–</p>
          </div>
        </section>

        <div class="grid gap-6 lg:grid-cols-3">
          <!-- Por categoría -->
          <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 lg:col-span-1">
            <h2 class="mb-3 font-semibold">Por categoría</h2>
            <div id="cats" class="space-y-3"></div>
          </section>

          <!-- Simulador del Atajo -->
          <section class="rounded-2xl bg-slate-900 p-4 text-slate-100 shadow lg:col-span-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h2 class="font-semibold">📱 Simulador del Atajo de iPhone</h2>
                <p class="text-xs text-slate-400">Hace lo mismo que hará el Atajo al pagar con Apple Pay.</p>
              </div>
              <button id="sim" class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-slate-200">Simular pago con Apple Pay</button>
            </div>
            <pre id="sim-log" class="mt-3 max-h-48 overflow-auto rounded-lg bg-black/40 p-3 text-xs leading-relaxed text-emerald-300">Pulsa el botón para enviar un pago de prueba a /v1/ingest…</pre>
          </section>
        </div>

        <!-- Nuevo gasto -->
        <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
          <h2 class="mb-3 font-semibold">Registrar gasto manual</h2>
          <form id="tx-form" class="grid gap-3 sm:grid-cols-6">
            <select id="f-type" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-1">
              <option value="cash">💵 Efectivo</option>
              <option value="card">💳 Tarjeta</option>
            </select>
            <input id="f-merchant" required placeholder="Comercio" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-2" />
            <input id="f-amount" required placeholder="Monto (ej. 25.000)" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-1" />
            <select id="f-category" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-2"></select>
            <input id="f-card" placeholder="Tarjeta (ej. Visa 4242)" class="hidden rounded-lg border border-slate-300 px-3 py-2 sm:col-span-2" />
            <input id="f-desc" placeholder="Descripción (opcional)" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-3" />
            <button class="rounded-lg bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-700 sm:col-span-1">Agregar</button>
          </form>
        </section>

        <!-- Lista -->
        <section class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b p-4">
            <h2 class="font-semibold">Transacciones</h2>
            <div class="flex gap-2 text-sm">
              <select id="flt-type" class="rounded-lg border border-slate-300 px-2 py-1">
                <option value="">Todos los tipos</option>
                <option value="card">💳 Tarjeta</option>
                <option value="cash">💵 Efectivo</option>
              </select>
              <select id="flt-status" class="rounded-lg border border-slate-300 px-2 py-1">
                <option value="">Todos los estados</option>
                <option value="approved">Aprobada</option>
                <option value="pending">Pendiente</option>
                <option value="declined">Declinada</option>
                <option value="refunded">Reembolsada</option>
              </select>
            </div>
          </div>
          <ul id="list" class="divide-y"></ul>
        </section>
        </div>

        <!-- ============ REPORTES ============ -->
        <div id="tab-reportes" class="hidden space-y-6">
          <section id="r-kpis" class="grid grid-cols-2 gap-3 lg:grid-cols-4"></section>
          <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <h2 class="mb-6 font-semibold">Gasto diario · últimos 30 días</h2>
            <div id="r-daily-chart"></div>
          </section>
          <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
              <h2 class="mb-3 font-semibold">Reporte semanal</h2>
              <div id="r-weekly" class="space-y-4"></div>
            </section>
            <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
              <h2 class="mb-3 font-semibold">Por categoría</h2>
              <div id="r-cats" class="space-y-3"></div>
              <h2 class="mb-3 mt-6 font-semibold">Top comercios</h2>
              <ol id="r-merch" class="space-y-2 text-sm"></ol>
            </section>
          </div>
          <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <h2 class="mb-3 font-semibold">Detalle por día</h2>
            <div class="max-h-80 overflow-auto"><table id="r-table" class="w-full text-sm"></table></div>
          </section>
        </div>

        <!-- ============ METAS ============ -->
        <div id="tab-metas" class="hidden space-y-6">
          <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
            <h2 id="g-title" class="font-semibold">Metas del mes</h2>
            <form id="g-form" class="mt-3 grid gap-3 sm:grid-cols-4">
              <select id="g-cat" class="rounded-lg border border-slate-300 px-3 py-2"></select>
              <input id="g-limit" required placeholder="Límite mensual (ej. 2.000.000)" class="rounded-lg border border-slate-300 px-3 py-2 sm:col-span-2" />
              <button class="rounded-lg bg-emerald-600 py-2 font-semibold text-white hover:bg-emerald-700">Crear meta</button>
            </form>
          </section>
          <div id="g-list" class="grid gap-4 md:grid-cols-2"></div>
        </div>
      </main>
    </div>

    <!-- Llave de recuperación -->
    <div id="recovery" class="fixed inset-0 z-20 hidden items-center justify-center bg-black/60 p-4">
      <div class="w-full max-w-md space-y-3 rounded-2xl bg-white p-6 shadow-xl">
        <h2 class="text-lg font-bold">🔑 Guarda tu llave de recuperación</h2>
        <p class="text-sm text-slate-600">Es la única forma de recuperar tus datos si olvidas la contraseña. No se vuelve a mostrar.</p>
        <code id="rk" class="block break-all rounded-lg bg-slate-100 p-3 text-xs"></code>
        <div class="flex gap-2">
          <button id="rk-copy" class="flex-1 rounded-lg border py-2 text-sm hover:bg-slate-100">Copiar</button>
          <button id="rk-ok" class="flex-1 rounded-lg bg-emerald-600 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Ya la guardé</button>
        </div>
      </div>
    </div>

    <div id="toast" class="fixed bottom-4 left-1/2 z-30 hidden max-w-[90vw] -translate-x-1/2 rounded-lg bg-slate-900 px-4 py-2 text-sm text-white shadow-lg"></div>

    <script>
      const $ = (s) => document.querySelector(s);
      const store = {
        get: (k, d = null) => localStorage.getItem(k) ?? d,
        set: (k, v) => localStorage.setItem(k, v),
        del: (k) => localStorage.removeItem(k),
      };
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const CATS = ['comida', 'mercado', 'transporte', 'ocio', 'servicios', 'salud', 'otros'];
      const STATUS = { approved: 'Aprobada', pending: 'Pendiente', declined: 'Declinada', refunded: 'Reembolsada' };
      const STATUS_CLS = {
        approved: 'bg-emerald-100 text-emerald-800', pending: 'bg-amber-100 text-amber-800',
        declined: 'bg-rose-100 text-rose-800', refunded: 'bg-sky-100 text-sky-800',
      };
      let API = store.get('apiUrl', 'http://localhost:3000');
      let mode = 'login';

      function money(n, cur = 'COP') {
        try { return new Intl.NumberFormat('es-CO', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
        catch { return `${n} ${cur}`; }
      }
      let toastT;
      function toast(msg) {
        const t = $('#toast');
        t.textContent = msg; t.classList.remove('hidden');
        clearTimeout(toastT); toastT = setTimeout(() => t.classList.add('hidden'), 4000);
      }

      // ---------- Cliente de la API ----------
      async function call(method, path, body, o = {}) {
        const token = o.token ?? (o.auth === false ? null : store.get('at'));
        let res;
        try {
          res = await fetch(API + path, {
            method,
            headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: 'Bearer ' + token } : {}) },
            body: body ? JSON.stringify(body) : undefined,
          });
        } catch {
          throw new Error(`No se pudo conectar con ${API}. ¿Está corriendo la API? ¿CORS_ORIGINS incluye ${location.origin}?`);
        }
        if (res.status === 401 && o.auth !== false && !o.token && o.retry !== false && store.get('rt') && (await refresh())) {
          return call(method, path, body, { ...o, retry: false });
        }
        const text = await res.text();
        let data = null;
        try { data = text ? JSON.parse(text) : null; } catch { data = { error: text }; }
        if (res.status === 429) {
          // La API responde { error, retryAfterSec }: límite general de /v1/auth/* o espera entre reenvíos del código.
          const retryAfterSec = Number(data?.retryAfterSec ?? res.headers.get('RateLimit-Reset')) || 0;
          const generic = !data?.error || data.error.startsWith('Demasiados intentos');
          const msg = generic && retryAfterSec >= 60
            ? `Demasiados intentos. Espera ${Math.ceil(retryAfterSec / 60)} min y vuelve a intentar.`
            : data?.error || 'Demasiados intentos. Espera unos minutos y vuelve a intentar.';
          throw Object.assign(new Error(msg), { status: 429, data, retryAfterSec });
        }
        if (!res.ok) {
          const det = data?.details?.map((d) => `${d.field}: ${d.message}`).join(' · ');
          throw Object.assign(new Error(det || data?.error || `Error ${res.status}`), { status: res.status, data });
        }
        return data;
      }

      function setSession(r) {
        store.set('at', r.accessToken);
        store.set('rt', r.refreshToken);
      }
      async function refresh() {
        try {
          setSession(await call('POST', '/v1/auth/refresh', { refreshToken: store.get('rt') }, { auth: false }));
          return true;
        } catch {
          clearSession(); showAuth();
          return false;
        }
      }
      function clearSession() { ['at', 'rt', 'it'].forEach(store.del); }

      // ---------- Pantallas ----------
      function showAuth() {
        $('#app').classList.add('hidden');
        $('#auth').classList.remove('hidden'); $('#auth').classList.add('flex');
        $('#a-api').value = API;
        showEmailVerify(null);
        showMfa(null);
      }
      function showApp() {
        $('#auth').classList.add('hidden'); $('#auth').classList.remove('flex');
        $('#app').classList.remove('hidden');
        $('#api-url').textContent = API;
        showTab('resumen');
        load();
      }

      const SUB = { login: 'Inicia sesión para ver tus gastos', register: 'Crea tu cuenta', recover: 'Recupera tu cuenta con la llave de recuperación' };
      function setMode(m) {
        mode = m;
        const reg = m === 'register', rec = m === 'recover';
        $('#auth-sub').textContent = SUB[m];
        $('#a-submit').textContent = reg ? 'Crear cuenta' : rec ? 'Recuperar cuenta' : 'Entrar';
        $('#a-toggle').textContent = m === 'login' ? '¿No tienes cuenta? Crear una' : '¿Ya tienes cuenta? Inicia sesión';
        $('#a-forgot').classList.toggle('hidden', m !== 'login');
        $('#a-rk').classList.toggle('hidden', !rec); $('#a-rk').required = rec;
        $('#a-pass').placeholder = rec ? 'Nueva contraseña (mínimo 10 caracteres)' : 'Contraseña (mínimo 10 caracteres)';
      }
      $('#a-toggle').onclick = () => setMode(mode === 'login' ? 'register' : 'login');
      $('#a-forgot').onclick = () => setMode('recover');

      // ---------- MFA (Microsoft / Google Authenticator) ----------
      // El mfaToken vive solo en memoria: dura 10 min, es de un solo uso y no sirve como sesión.
      let mfa = null; // { token, enrolling }
      function showMfa(r) {
        mfa = r && { token: r.mfaToken, enrolling: !!r.mfaSetupRequired };
        if (mfa) $('#email-form').classList.add('hidden');
        $('#auth-form').classList.toggle('hidden', !!mfa);
        $('#mfa-form').classList.toggle('hidden', !mfa);
        $('#mfa-form').reset();
        if (!mfa) return;
        $('#mfa-setup').classList.toggle('hidden', !mfa.enrolling);
        $('#mfa-sub').textContent = mfa.enrolling
          ? 'Para proteger tu cuenta, vincula una app de autenticación.'
          : 'Escribe el código de 6 dígitos de tu app Authenticator.';
        if (mfa.enrolling) { $('#mfa-qr').src = r.mfaSetup.qrCode; $('#mfa-secret').textContent = r.mfaSetup.secret; }
        $('#mfa-code').focus();
      }
      $('#mfa-form').onsubmit = async (e) => {
        e.preventDefault();
        const code = $('#mfa-code').value.replace(/\D/g, ''); // quita espacios u otros caracteres al pegar
        if (code.length !== 6) return toast('El código debe tener 6 dígitos');
        const path = mfa.enrolling ? '/v1/auth/mfa/setup/confirm' : '/v1/auth/login/mfa';
        try {
          setSession(await call('POST', path, { mfaToken: mfa.token, code }, { auth: false }));
          $('#a-pass').value = $('#a-rk').value = '';
          showMfa(null); setMode('login'); showApp();
        } catch (err) {
          toast(err.message);
          // mfaToken vencido o anulado tras 5 intentos: hay que volver a poner la contraseña.
          if (err.message.startsWith('mfaToken')) showMfa(null);
          else { $('#mfa-code').value = ''; $('#mfa-code').focus(); }
        }
      };
      $('#mfa-cancel').onclick = () => showMfa(null);
      $('#mfa-secret-copy').onclick = () => navigator.clipboard.writeText($('#mfa-secret').textContent).then(() => toast('Clave copiada'));

      // ---------- Verificación del correo ----------
      // Las credenciales quedan solo en memoria para hacer login automático al verificar el correo.
      let ev = null; // { email, password, sentAt }
      let resendTimer;
      function showEmailVerify(v, { emailSent = true, warn = '' } = {}) {
        ev = v;
        clearInterval(resendTimer);
        $('#email-form').classList.toggle('hidden', !ev);
        $('#auth-form').classList.toggle('hidden', !!ev);
        $('#email-form').reset();
        if (!ev) return;
        $('#mfa-form').classList.add('hidden');
        $('#ev-email').textContent = ev.email;
        setEvWarn(warn || (emailSent ? '' : 'No pudimos enviar el correo. Pulsa “Reenviar código”.'));
        // La API exige esperar 60 s entre envíos; si el correo no salió se puede reenviar ya.
        startResendCooldown(emailSent && ev.sentAt ? 60 - Math.floor((Date.now() - ev.sentAt) / 1000) : 0);
        $('#ev-code').focus();
      }
      function setEvWarn(msg) {
        $('#ev-warn').textContent = msg;
        $('#ev-warn').classList.toggle('hidden', !msg);
      }
      function startResendCooldown(sec) {
        clearInterval(resendTimer);
        const btn = $('#ev-resend');
        let left = Math.max(0, Math.ceil(sec));
        const tick = () => {
          btn.disabled = left > 0;
          btn.textContent = left > 0 ? `Reenviar código (${left} s)` : 'Reenviar código';
          if (left-- <= 0) clearInterval(resendTimer);
        };
        tick();
        if (left >= 0) resendTimer = setInterval(tick, 1000);
      }
      $('#email-form').onsubmit = async (e) => {
        e.preventDefault();
        const code = $('#ev-code').value.replace(/\D/g, '');
        if (code.length !== 6) return toast('El código debe tener 6 dígitos');
        $('#ev-submit').disabled = true;
        try {
          await call('POST', '/v1/auth/verify-email', { email: ev.email, code }, { auth: false });
          toast('Correo verificado ✅');
          const { email, password } = ev;
          showEmailVerify(null);
          // Con el correo verificado, el login devuelve el QR (primera vez) o pide el código del Authenticator.
          if (password) {
            try { showMfa(await call('POST', '/v1/auth/login', { email, password }, { auth: false })); }
            catch (err) { toast(err.message); setMode('login'); }
          } else setMode('login');
        } catch (err) {
          $('#ev-code').value = ''; $('#ev-code').focus();
          if (err.status === 401 && err.data?.attemptsLeft != null) {
            const n = err.data.attemptsLeft;
            if (n > 0) toast(`Código incorrecto. Te quedan ${n} intento${n === 1 ? '' : 's'}.`);
            else { toast('Código incorrecto.'); setEvWarn('Agotaste los intentos de este código. Pide uno nuevo con “Reenviar código”.'); }
          } else {
            toast(err.message);
            // Código vencido, sin intentos o inexistente: hay que pedir uno nuevo.
            if (err.status === 400 && /pide uno nuevo|pide un código nuevo/.test(err.message)) setEvWarn(err.message);
          }
        } finally { $('#ev-submit').disabled = false; }
      };
      $('#ev-resend').onclick = async () => {
        $('#ev-resend').disabled = true;
        try {
          await call('POST', '/v1/auth/resend-code', { email: ev.email }, { auth: false });
          ev.sentAt = Date.now();
          setEvWarn('');
          toast('Te enviamos un código nuevo. El anterior ya no sirve.');
          startResendCooldown(60);
          $('#ev-code').focus();
        } catch (err) {
          toast(err.message);
          startResendCooldown(err.status === 429 ? err.retryAfterSec || 60 : 0);
        }
      };
      $('#ev-cancel').onclick = () => showEmailVerify(null);

      $('#auth-form').onsubmit = async (e) => {
        e.preventDefault();
        API = $('#a-api').value.trim().replace(/\/$/, '') || API;
        store.set('apiUrl', API);
        const email = $('#a-email').value.trim(), pass = $('#a-pass').value;
        const body = mode === 'recover' ? { email, recoveryKey: $('#a-rk').value.trim(), newPassword: pass } : { email, password: pass };
        try {
          // Ninguno entrega sesión. Registro → código al correo; login/recover → mfaToken (y QR si toca).
          const r = await call('POST', '/v1/auth/' + mode, body, { auth: false });
          pendingAuth = { r, email, password: pass, sentAt: mode === 'register' ? Date.now() : null };
          if (r.recoveryKey) {
            $('#rk').textContent = r.recoveryKey;
            $('#recovery').classList.remove('hidden'); $('#recovery').classList.add('flex');
          } else continueAuth();
        } catch (err) {
          // Contraseña correcta pero correo sin verificar: pedir el código del correo.
          if (err.status === 403 && err.data?.emailVerificationRequired) {
            showEmailVerify({ email, password: pass, sentAt: null },
              { warn: 'Tu correo aún no está verificado. Escribe el código que te enviamos o pide uno nuevo.' });
          } else toast(err.message);
        }
      };
      let pendingAuth = null; // respuesta guardada mientras el usuario anota la llave de recuperación
      function continueAuth() {
        const { r, email, password, sentAt } = pendingAuth; pendingAuth = null;
        if (r.emailVerificationRequired) {
          showEmailVerify({ email, password, sentAt }, {
            emailSent: r.emailSent !== false,
            warn: sentAt ? '' : 'Tu correo aún no está verificado. Escribe el código que te enviamos o pide uno nuevo.',
          });
        } else showMfa(r);
      }
      $('#rk-copy').onclick = () => navigator.clipboard.writeText($('#rk').textContent).then(() => toast('Copiada'));
      $('#rk-ok').onclick = () => {
        $('#recovery').classList.add('hidden'); $('#recovery').classList.remove('flex');
        continueAuth();
      };

      $('#logout').onclick = async () => {
        try { await call('POST', '/v1/auth/logout', {}); } catch {}
        clearSession(); showAuth();
      };
      $('#api-url').onclick = () => {
        const v = prompt('URL de la API', API);
        if (v) { API = v.trim().replace(/\/$/, ''); store.set('apiUrl', API); $('#api-url').textContent = API; load(); }
      };

      // ---------- Datos ----------
      async function load() {
        const qs = new URLSearchParams({ limit: '200' });
        if ($('#flt-type').value) qs.set('type', $('#flt-type').value);
        if ($('#flt-status').value) qs.set('status', $('#flt-status').value);
        try {
          const [list, sum] = await Promise.all([
            call('GET', '/v1/transactions?' + qs), call('GET', '/v1/transactions/summary'),
          ]);
          renderSummary(sum); renderList(list.items);
        } catch (err) { toast(err.message); }
      }

      function renderSummary(s) {
        $('#k-total').textContent = money(s.total);
        $('#k-count').textContent = s.count;
        $('#k-declined').textContent = s.declined_count;
        $('#k-card').textContent = money(s.by_type.card || 0);
        $('#k-cash').textContent = money(s.by_type.cash || 0);
        const cats = Object.entries(s.by_category).sort((a, b) => b[1] - a[1]);
        const max = cats[0]?.[1] || 1;
        $('#cats').innerHTML = cats.length
          ? cats.map(([c, v]) => `
            <div>
              <div class="mb-1 flex justify-between text-sm"><span class="capitalize">${esc(c.replace('_', ' '))}</span><span class="tabular-nums text-slate-500">${money(v)}</span></div>
              <div class="h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-emerald-500" style="width:${Math.max(4, (v / max) * 100)}%"></div></div>
            </div>`).join('')
          : '<p class="text-sm text-slate-400">Aún no hay gastos.</p>';
      }

      function renderList(items) {
        if (!items.length) { $('#list').innerHTML = '<li class="p-6 text-center text-sm text-slate-400">No hay transacciones. Agrega una o simula un pago.</li>'; return; }
        $('#list').innerHTML = items.map((t) => {
          const cats = CATS.includes(t.category) || !t.category ? CATS : [...CATS, t.category];
          const src = t.source === 'ios-shortcut' ? ' Atajo iOS' : t.source === 'manual' ? '✍️ Manual' : esc(t.source);
          const when = new Date(t.occurred_at).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
          return `
          <li class="flex flex-wrap items-center gap-3 px-4 py-3" data-id="${t.id}">
            <div class="text-xl">${t.type === 'cash' ? '💵' : '💳'}</div>
            <div class="min-w-0 flex-1">
              <p class="truncate font-medium">${esc(t.merchant)}</p>
              <p class="text-xs text-slate-500">${when}${t.card ? ' · ' + esc(t.card) : ''} · ${src}</p>
              ${t.description ? `<p class="truncate text-xs text-slate-400">${esc(t.description)}</p>` : ''}
            </div>
            <p class="font-semibold tabular-nums ${t.status === 'declined' ? 'text-slate-400 line-through' : ''}">${money(t.amount, t.currency)}</p>
            <select data-act="category" class="rounded-lg border border-slate-200 px-2 py-1 text-xs capitalize">
              <option value="">sin categoría</option>
              ${cats.map((c) => `<option value="${esc(c)}" ${t.category === c ? 'selected' : ''}>${esc(c)}</option>`).join('')}
            </select>
            <select data-act="status" class="rounded-full border-0 px-2 py-1 text-xs font-medium ${STATUS_CLS[t.status]}">
              ${Object.entries(STATUS).map(([k, v]) => `<option value="${k}" ${t.status === k ? 'selected' : ''}>${v}</option>`).join('')}
            </select>
            <button data-act="delete" class="rounded p-1 text-slate-400 hover:bg-rose-50 hover:text-rose-600" title="Borrar">✕</button>
          </li>`;
        }).join('');
      }

      $('#list').onchange = async (e) => {
        const act = e.target.dataset.act; if (!act) return;
        const id = e.target.closest('li').dataset.id;
        try {
          await call('PATCH', '/v1/transactions/' + id, act === 'status' ? { status: e.target.value } : { category: e.target.value || null });
          load();
        } catch (err) { toast(err.message); }
      };
      $('#list').onclick = async (e) => {
        if (e.target.dataset.act !== 'delete') return;
        if (!confirm('¿Borrar esta transacción?')) return;
        try { await call('DELETE', '/v1/transactions/' + e.target.closest('li').dataset.id); load(); }
        catch (err) { toast(err.message); }
      };
      $('#flt-type').onchange = $('#flt-status').onchange = load;

      // ---------- Formulario manual ----------
      $('#f-category').innerHTML = '<option value="">Categoría</option>' + CATS.map((c) => `<option value="${c}" class="capitalize">${c}</option>`).join('');
      $('#f-type').onchange = () => $('#f-card').classList.toggle('hidden', $('#f-type').value === 'cash');
      $('#tx-form').onsubmit = async (e) => {
        e.preventDefault();
        const type = $('#f-type').value;
        const body = { type, merchant: $('#f-merchant').value, amount: $('#f-amount').value };
        if ($('#f-category').value) body.category = $('#f-category').value;
        if ($('#f-desc').value) body.description = $('#f-desc').value;
        if (type === 'card' && $('#f-card').value) body.card = $('#f-card').value;
        try {
          await call('POST', '/v1/transactions', body);
          e.target.reset(); $('#f-card').classList.add('hidden');
          toast('Gasto agregado'); load();
        } catch (err) { toast(err.message); }
      };

      // ---------- Simulador del Atajo de iOS ----------
      const SIM = [
        { merchant: 'Rappi', amount: '$25.000,00', card: 'Visa 4242' },
        { merchant: 'Éxito', amount: '$87.450,00', card: 'Mastercard 1881' },
        { merchant: 'Uber', amount: '$18.300', card: 'Visa 4242' },
        { merchant: 'Netflix', amount: '$39.900', card: 'Visa 4242', status: 'declined' },
        { merchant: 'Starbucks', amount: 'COP 14,500.00', card: 'Amex 0005' },
        { merchant: 'Droguería Cruz Verde', amount: '$52.000,00', card: 'Mastercard 1881' },
      ];
      async function ensureIngestToken(force = false) {
        if (!force && store.get('it')) return store.get('it');
        const r = await call('POST', '/v1/ingest-tokens', { label: 'Simulador web' });
        store.set('it', r.token);
        return r.token;
      }
      $('#sim').onclick = async () => {
        const p = { ...SIM[Math.floor(Math.random() * SIM.length)], date: new Date().toISOString() };
        const log = $('#sim-log');
        try {
          let tok = await ensureIngestToken();
          const show = (extra) => (log.textContent =
            `POST ${API}/v1/ingest\nAuthorization: Bearer ${tok.slice(0, 9)}…\n\n${JSON.stringify(p, null, 2)}\n\n${extra}`);
          show('Enviando…');
          let res;
          try { res = await call('POST', '/v1/ingest', p, { token: tok }); }
          catch (err) {
            if (err.status !== 401) throw err;
            tok = await ensureIngestToken(true); // token revocado: crear otro
            res = await call('POST', '/v1/ingest', p, { token: tok });
          }
          show(`→ 201 ${JSON.stringify(res)}`);
          load();
        } catch (err) { log.textContent = 'Error: ' + err.message; toast(err.message); }
      };

      // ---------- Pestañas, Reportes y Metas ----------
      const TZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const iso = (d) => d.toLocaleDateString('en-CA'); // YYYY-MM-DD en hora local
      const fmtDay = (d) => new Date(d + 'T12:00:00').toLocaleDateString('es-CO', { weekday: 'short', day: 'numeric', month: 'short' });
      const fmtShort = (d) => new Date(d + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
      const card = 'rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200';
      let DEMO = false; // true = la API no tiene los endpoints nuevos: se muestran datos de ejemplo

      document.querySelectorAll('[data-tab]').forEach((b) => (b.onclick = () => showTab(b.dataset.tab)));
      function showTab(t) {
        ['resumen', 'reportes', 'metas'].forEach((x) => $('#tab-' + x).classList.toggle('hidden', x !== t));
        document.querySelectorAll('[data-tab]').forEach((b) => {
          const on = b.dataset.tab === t;
          b.classList.toggle('bg-white', on); b.classList.toggle('shadow', on); b.classList.toggle('text-slate-500', !on);
        });
        if (t === 'reportes') loadReports();
        if (t === 'metas') loadGoals();
      }
      // Pide a la API real; si el endpoint no existe (404) usa datos de ejemplo.
      async function getNew(path, demoFn) {
        if (!DEMO) {
          try { const r = await call('GET', path); $('#demo-note').classList.add('hidden'); return r; }
          catch (e) { if (e.status !== 404) throw e; DEMO = true; }
        }
        $('#demo-note').classList.remove('hidden');
        return demoFn();
      }
      $('#demo-retry').onclick = () => { DEMO = false; $('#tab-metas').classList.contains('hidden') ? loadReports() : loadGoals(); };

      // ----- Datos de ejemplo (misma forma que devolverá la API) -----
      const rnd = (i) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };
      function sampleDays(n = 56) {
        const out = [], today = new Date(); today.setHours(12, 0, 0, 0);
        for (let i = n - 1; i >= 0; i--) {
          const d = new Date(today); d.setDate(d.getDate() - i);
          const r = rnd(d.getFullYear() * 372 + d.getMonth() * 31 + d.getDate());
          const by = {};
          if (r > 0.15) ['comida', 'mercado', 'transporte', 'ocio', 'servicios'].forEach((c, k) => (by[c] = Math.round((15000 + r * 110000) * [0.35, 0.25, 0.2, 0.12, 0.08][k] / 1000) * 1000));
          const total = Object.values(by).reduce((a, b) => a + b, 0), card_ = Math.round(total * 0.8 / 1000) * 1000;
          out.push({ date: iso(d), total, count: total ? 1 + Math.floor(r * 4) : 0, by_category: by, by_type: { card: card_, cash: total - card_ } });
        }
        return out;
      }
      function sampleDaily() {
        const days = sampleDays().slice(-30), total = days.reduce((a, x) => a + x.total, 0);
        const top_merchants = [['Rappi', 0.22], ['Éxito', 0.18], ['Uber', 0.12], ['Starbucks', 0.08], ['Netflix', 0.05]]
          .map(([merchant, p]) => ({ merchant, total: Math.round(total * p / 1000) * 1000, count: Math.round(days.length * p * 0.8) }));
        return { tz: TZ, days, summary: { total, avg_per_day: Math.round(total / days.length), max_day: days.reduce((a, x) => (x.total > a.total ? x : a)), zero_days: days.filter((x) => !x.total).length, top_merchants } };
      }
      function sampleWeekly() {
        const weeks = {};
        sampleDays().forEach((x) => {
          const d = new Date(x.date + 'T12:00:00'); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); // lunes
          const w = (weeks[iso(d)] ||= { start: iso(d), total: 0, count: 0, days: 0 });
          w.total += x.total; w.count += x.count; w.days++;
        });
        const list = Object.values(weeks).sort((a, b) => (a.start < b.start ? -1 : 1)).slice(-8);
        list.forEach((w, i) => {
          const e = new Date(w.start + 'T12:00:00'); e.setDate(e.getDate() + 6);
          w.end = iso(e); w.avg_per_day = Math.round(w.total / w.days);
          w.change_pct = i && list[i - 1].total ? Math.round(((w.total - list[i - 1].total) / list[i - 1].total) * 100) : null;
        });
        return { tz: TZ, weeks: list };
      }
      let demoGoals = [{ id: 'd1', category: null, limit: 2500000 }, { id: 'd2', category: 'comida', limit: 600000 }];
      const parseLimit = (v) => Number(String(v).replace(/[^\d]/g, ''));
      function demoProgress() {
        const m = iso(new Date()).slice(0, 7), md = sampleDays().filter((x) => x.date.startsWith(m));
        const now = new Date(), dim = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate(), el = now.getDate(), left = dim - el + 1;
        const goals = demoGoals.map((g) => {
          const spent = md.reduce((a, x) => a + (g.category ? x.by_category[g.category] || 0 : x.total), 0), remaining = g.limit - spent, percent = Math.round((spent / g.limit) * 100);
          return { id: g.id, category: g.category, limit: g.limit, spent, remaining, percent, status: percent >= 100 ? 'exceeded' : percent >= 80 ? 'warning' : 'ok', daily_allowance: remaining > 0 ? Math.round(remaining / left) : 0, projected: Math.round((spent / el) * dim) };
        });
        return { month: m, days_in_month: dim, days_elapsed: el, days_left: left, goals };
      }

      // ----- Reportes -----
      async function loadReports() {
        const q = '?tz=' + encodeURIComponent(TZ);
        try {
          const [d, w] = await Promise.all([getNew('/v1/reports/daily' + q, sampleDaily), getNew('/v1/reports/weekly' + q + '&weeks=8', sampleWeekly)]);
          renderReports(d, w);
        } catch (e) { toast(e.message); }
      }
      function renderReports(d, w) {
        const s = d.summary, max = Math.max(...d.days.map((x) => x.total), 1);
        const kpi = (l, v, sub = '') => `<div class="${card}"><p class="text-xs uppercase text-slate-500">${l}</p><p class="mt-1 text-xl font-bold">${v}</p><p class="text-xs text-slate-400">${sub}</p></div>`;
        $('#r-kpis').innerHTML = kpi('Total del período', money(s.total), d.days.length + ' días') + kpi('Promedio diario', money(s.avg_per_day))
          + kpi('Día de mayor gasto', money(s.max_day.total), fmtDay(s.max_day.date)) + kpi('Días sin gasto', s.zero_days);

        $('#r-daily-chart').innerHTML = `
          <div class="relative flex h-44 items-end gap-0.5 border-b border-slate-200">
            <div class="absolute inset-x-0 border-t border-dashed border-amber-500" style="bottom:${(s.avg_per_day / max) * 100}%"><span class="absolute -top-4 right-0 text-[10px] text-amber-600">promedio ${money(s.avg_per_day)}</span></div>
            ${d.days.map((x) => `<div class="flex-1 rounded-t ${x.total === s.max_day.total ? 'bg-rose-500' : 'bg-emerald-500'}" style="height:${x.total ? Math.max(2, (x.total / max) * 100) : 0}%" title="${fmtDay(x.date)}: ${money(x.total)}"></div>`).join('')}
          </div>
          <div class="mt-1 flex gap-0.5 text-[9px] text-slate-400">${d.days.map((x) => `<span class="flex-1 text-center">${+x.date.slice(8)}</span>`).join('')}</div>`;

        const wmax = Math.max(...w.weeks.map((x) => x.total), 1);
        $('#r-weekly').innerHTML = w.weeks.slice().reverse().map((x) => {
          const c = x.change_pct, arrow = c == null ? '' : `<span class="${c > 0 ? 'text-rose-600' : 'text-emerald-600'}">${c > 0 ? '▲' : '▼'} ${Math.abs(c)}%</span>`;
          return `<div><div class="mb-1 flex justify-between text-sm"><span>${fmtShort(x.start)} – ${fmtShort(x.end)}</span><span class="tabular-nums">${money(x.total)} ${arrow}</span></div>
            <div class="h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-sky-500" style="width:${Math.max(2, (x.total / wmax) * 100)}%"></div></div>
            <p class="mt-0.5 text-xs text-slate-400">${x.count} movimientos · ${money(x.avg_per_day)} por día</p></div>`;
        }).join('');

        const cats = {};
        d.days.forEach((x) => Object.entries(x.by_category).forEach(([c, v]) => (cats[c] = (cats[c] || 0) + v)));
        const ce = Object.entries(cats).sort((a, b) => b[1] - a[1]), cmax = ce[0]?.[1] || 1;
        $('#r-cats').innerHTML = ce.map(([c, v]) => `<div><div class="mb-1 flex justify-between text-sm"><span class="capitalize">${esc(c.replace('_', ' '))}</span><span class="tabular-nums text-slate-500">${money(v)}</span></div><div class="h-2 rounded-full bg-slate-100"><div class="h-2 rounded-full bg-emerald-500" style="width:${(v / cmax) * 100}%"></div></div></div>`).join('') || '<p class="text-sm text-slate-400">Sin datos.</p>';
        $('#r-merch').innerHTML = s.top_merchants.map((m, i) => `<li class="flex justify-between"><span><span class="mr-2 text-slate-400">${i + 1}.</span>${esc(m.merchant)} <span class="text-xs text-slate-400">(${m.count})</span></span><span class="tabular-nums">${money(m.total)}</span></li>`).join('') || '<li class="text-slate-400">Sin datos.</li>';

        $('#r-table').innerHTML = '<thead class="sticky top-0 bg-white text-left text-xs uppercase text-slate-500"><tr><th class="py-2">Día</th><th>Mov.</th><th>Categoría principal</th><th class="text-right">Total</th></tr></thead><tbody class="divide-y">'
          + d.days.slice().reverse().map((x) => {
            const top = Object.entries(x.by_category).sort((a, b) => b[1] - a[1])[0];
            return `<tr class="${x.total ? '' : 'text-slate-300'}"><td class="py-2">${fmtDay(x.date)}</td><td>${x.count}</td><td class="capitalize">${top ? esc(top[0].replace('_', ' ')) : '—'}</td><td class="text-right font-medium tabular-nums">${money(x.total)}</td></tr>`;
          }).join('') + '</tbody>';
      }

      // ----- Metas -----
      $('#g-cat').innerHTML = '<option value="">Total del mes</option>' + CATS.map((c) => `<option value="${c}">${c}</option>`).join('');
      async function loadGoals() {
        try { renderGoals(await getNew('/v1/goals/progress?tz=' + encodeURIComponent(TZ), demoProgress)); } catch (e) { toast(e.message); }
      }
      function renderGoals(p) {
        const mes = new Date(p.month + '-15').toLocaleDateString('es-CO', { month: 'long', year: 'numeric' });
        $('#g-title').textContent = `Metas de ${mes} · faltan ${p.days_left} días`;
        const COL = { ok: 'bg-emerald-500', warning: 'bg-amber-500', exceeded: 'bg-rose-500' };
        $('#g-list').innerHTML = p.goals.map((g) => `
          <div class="${card}" data-id="${g.id}">
            <div class="flex items-center justify-between"><h3 class="font-semibold capitalize">${g.category ? esc(g.category) : 'Total del mes'}</h3>
              <div class="flex gap-3 text-xs"><button data-g="edit" class="text-slate-500 hover:underline">Editar</button><button data-g="del" class="text-rose-600 hover:underline">Borrar</button></div></div>
            <p class="mt-2 text-2xl font-bold tabular-nums ${g.remaining < 0 ? 'text-rose-600' : ''}">${money(Math.abs(g.remaining))}</p>
            <p class="text-xs text-slate-500">${g.remaining >= 0 ? 'te quedan' : 'te pasaste'} · meta ${money(g.limit)}</p>
            <div class="mt-3 h-3 overflow-hidden rounded-full bg-slate-100"><div class="h-3 ${COL[g.status]}" style="width:${Math.min(100, g.percent)}%"></div></div>
            <p class="mt-1 text-xs text-slate-500">${g.percent}% usado · llevas ${money(g.spent)}</p>
            <ul class="mt-3 space-y-1 text-sm text-slate-600">
              <li>📅 ${g.remaining > 0 ? `Puedes gastar <b>${money(g.daily_allowance)}</b> por día` : 'Ya no queda presupuesto este mes'}</li>
              <li class="${g.projected > g.limit ? 'text-rose-600' : ''}">📈 A este ritmo terminarías en <b>${money(g.projected)}</b></li>
            </ul></div>`).join('') || '<p class="text-sm text-slate-400">Aún no tienes metas. Crea la primera arriba.</p>';
      }
      $('#g-form').onsubmit = async (e) => {
        e.preventDefault();
        const body = { category: $('#g-cat').value || null, limit: $('#g-limit').value };
        try {
          if (DEMO) demoGoals.push({ id: 'd' + Date.now(), category: body.category, limit: parseLimit(body.limit) });
          else await call('POST', '/v1/goals', body);
          e.target.reset(); loadGoals();
        } catch (err) { toast(err.message); }
      };
      $('#g-list').onclick = async (e) => {
        const a = e.target.dataset.g; if (!a) return;
        const id = e.target.closest('[data-id]').dataset.id;
        try {
          if (a === 'del') {
            if (!confirm('¿Borrar esta meta?')) return;
            if (DEMO) demoGoals = demoGoals.filter((g) => g.id !== id); else await call('DELETE', '/v1/goals/' + id);
          } else {
            const v = prompt('Nuevo límite mensual'); if (!v) return;
            if (DEMO) demoGoals.find((g) => g.id === id).limit = parseLimit(v); else await call('PATCH', '/v1/goals/' + id, { limit: v });
          }
          loadGoals();
        } catch (err) { toast(err.message); }
      };

      // ---------- Arranque ----------
      store.get('at') ? showApp() : showAuth();
    </script>
  </body>
</html>