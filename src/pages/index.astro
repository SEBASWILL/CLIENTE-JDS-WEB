---
// Landing page. La aplicación (login y panel) está en /app (src/pages/app.astro).
import '../styles/global.css';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.jpeg';
import { APP_NAME } from '../config';

import Navbar from '../components/landing/Navbar.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Features from '../components/landing/Features.astro';
import Security from '../components/landing/Security.astro';
import DownloadApp from '../components/landing/DownloadApp.astro';
import Faq from '../components/landing/Faq.astro';
import Footer from '../components/landing/Footer.astro';

const description = 'Registra tus gastos automáticamente al pagar con Apple Pay. Resumen, reportes y metas mensuales en un solo lugar.';
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{APP_NAME} · Tus gastos, sin escribir nada</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0F1E" />
    <meta property="og:title" content={APP_NAME} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-fondo font-inter text-texto antialiased">
    <Navbar />
    <main>
      <Hero />
      <HowItWorks />
      <Features />
      <Security />
      <DownloadApp />
      <Faq />
    </main>
    <Footer />
  </body>
</html>
