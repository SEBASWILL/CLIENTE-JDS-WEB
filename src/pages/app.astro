---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { VERSION, APP_NAME } from '../config';
import Logo from '../components/Logo.astro';
import logo from '../assets/logo.jpeg';

const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{APP_NAME}</title>
    <meta name="theme-color" content="#F4F5F9" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="tema-claro min-h-screen bg-fondo font-inter text-texto antialiased">

    <!-- ============ LOGIN / REGISTRO ============ -->
    <main id="auth" class="hidden min-h-screen lg:grid-cols-[1.05fr_1fr]">
      <!-- Panel de marca (solo en pantallas grandes) -->
      <aside class="relative hidden overflow-hidden bg-cashly-fondo p-12 text-white lg:flex lg:flex-col lg:justify-between">
        <div class="fondo-cuadricula pointer-events-none absolute inset-0"></div>
        <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand/30 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-brand-cian/20 blur-3xl"></div>

        <a href="/" class="relative text-xl"><Logo size={40} /></a>

        <div class="relative max-w-md">
          <h2 class="text-4xl leading-tight font-extrabold tracking-tight">
            Tus gastos se registran <span class="text-cashly">solos</span>.
          </h2>
          <p class="mt-4 text-white/70">
            Paga con Apple Pay y mira al instante en qué se va tu plata, cuánto llevas y cuánto te queda del mes.
          </p>

          <!-- Tarjetas de ejemplo -->
          <div class="mt-10 space-y-3">
            <div class="flex items-center gap-3 rounded-2xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-cashly text-lg">⚡</span>
              <div class="flex-1">
                <p class="text-sm font-semibold">Gasto registrado</p>
                <p class="text-xs text-white/60">Rappi · Visa 4242 · hace un momento</p>
              </div>
              <p class="font-bold">$ 25.000</p>
            </div>
            <div class="ml-10 rounded-2xl bg-white/10 p-4 ring-1 ring-white/15 backdrop-blur">
              <div class="flex items-center justify-between text-sm">
                <span class="font-semibold">🎯 Meta de comida</span>
                <span class="text-white/70">69%</span>
              </div>
              <div class="mt-2 h-2 rounded-full bg-white/15"><div class="h-2 w-[69%] rounded-full bg-cashly"></div></div>
              <p class="mt-2 text-xs text-white/60">Puedes gastar $ 8.500 por día</p>
            </div>
          </div>
        </div>

        <p class="relative text-xs text-white/50">🔐 Protegido con verificación en dos pasos y llave de recuperación.</p>
      </aside>

      <!-- Formularios -->
      <div class="flex items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-sm">
          <a href="/" class="mb-10 inline-block text-xl lg:hidden"><Logo size={36} /></a>

          <form id="auth-form" class="space-y-5">
            <div>
              <h1 class="text-3xl font-bold tracking-tight">Hola de nuevo 👋</h1>
              <p id="auth-sub" class="mt-2 text-texto-2">Inicia sesión para ver tus gastos</p>
            </div>
            <div>
              <label for="a-email" class="field-label">Correo</label>
              <input id="a-email" type="email" required placeholder="correo@ejemplo.com" class="field w-full" />
            </div>
            <div id="a-rk-field" class="hidden">
              <label for="a-rk" class="field-label">Llave de recuperación</label>
              <input id="a-rk" placeholder="XXXX-XXXX-XXXX-XXXX" autocomplete="off" class="field w-full font-mono text-sm" />
            </div>
            <div>
              <label for="a-pass" class="field-label">Contraseña</label>
              <div class="relative">
                <input id="a-pass" type="password" required minlength="10" placeholder="Contraseña (mínimo 10 caracteres)" class="field w-full pr-12" />
                <button type="button" id="a-pass-toggle" class="absolute inset-y-0 right-0 px-3.5 text-texto-3 transition hover:text-texto" title="Mostrar contraseña">👁</button>
              </div>
            </div>
            <button id="a-submit" class="btn-primary w-full py-3">Entrar</button>
            <div class="space-y-3 border-t border-borde pt-5 text-center">
              <button type="button" id="a-toggle" class="btn-link font-semibold text-brand hover:text-[#3D5EF0]">¿No tienes cuenta? Crear una</button>
              <button type="button" id="a-forgot" class="btn-link text-xs">¿Olvidaste la contraseña o perdiste el celular?</button>
            </div>
          </form>

          <!-- Verificación del correo: código de 6 dígitos enviado al registrarse -->
          <form id="email-form" class="hidden space-y-5">
            <div>
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-2xl">📧</span>
              <h1 class="mt-5 text-3xl font-bold tracking-tight">Verifica tu correo</h1>
              <p class="mt-2 text-texto-2">Te enviamos un código de 6 dígitos a <b id="ev-email" class="break-all text-texto"></b>. Vence en 10 minutos.</p>
            </div>
            <p id="ev-warn" class="hidden rounded-xl bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-amber-200"></p>
            <input id="ev-code" required inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="123 456" class="field field-code w-full py-3.5" />
            <button id="ev-submit" class="btn-primary w-full py-3">Verificar correo</button>
            <button type="button" id="ev-resend" class="btn-secondary w-full">Reenviar código</button>
            <p class="text-center text-xs text-texto-3">¿No lo ves? Revisa la carpeta de spam o promociones.</p>
            <button type="button" id="ev-cancel" class="btn-link">← Cancelar y volver</button>
          </form>

          <!-- Segundo paso: código del Authenticator (y QR si aún no lo configuró) -->
          <form id="mfa-form" class="hidden space-y-5">
            <div>
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-2xl">🔐</span>
              <h1 class="mt-5 text-3xl font-bold tracking-tight">Verificación</h1>
              <p id="mfa-sub" class="mt-2 text-texto-2">Escribe el código de 6 dígitos de tu app Authenticator.</p>
            </div>
            <div id="mfa-setup" class="hidden space-y-4">
              <ol class="list-decimal space-y-1 pl-5 text-sm text-texto-2 marker:font-semibold marker:text-brand">
                <li>Abre Microsoft Authenticator (o Google Authenticator).</li>
                <li>Toca <b class="text-texto">+</b> → <b class="text-texto">Otra cuenta</b> y escanea este código.</li>
                <li>Escribe abajo el código de 6 dígitos que aparece.</li>
              </ol>
              <div class="mx-auto w-fit rounded-2xl bg-white p-3 shadow-sm ring-1 ring-borde">
                <img id="mfa-qr" alt="Código QR para el Authenticator" class="h-44 w-44" />
              </div>
              <details class="text-xs text-texto-2">
                <summary class="cursor-pointer hover:text-texto">¿No puedes escanear? Escribe la clave a mano</summary>
                <div class="mt-2 flex items-center gap-2">
                  <code id="mfa-secret" class="flex-1 rounded-lg bg-superficie-2 p-2 font-mono break-all text-brand ring-1 ring-borde"></code>
                  <button type="button" id="mfa-secret-copy" class="btn-secondary px-3 py-2 text-xs">Copiar</button>
                </div>
              </details>
            </div>
            <input id="mfa-code" required inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="123 456" class="field field-code w-full py-3.5" />
            <button class="btn-primary w-full py-3">Verificar</button>
            <button type="button" id="mfa-cancel" class="btn-link">← Cancelar y volver</button>
          </form>
        </div>
      </div>
    </main>

    <!-- ============ APP ============ -->
    <div id="app" class="hidden">
      <header class="sticky top-0 z-10 border-b border-borde bg-superficie/85 backdrop-blur">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
          <a href="/" class="text-lg"><Logo size={30} /></a>
          <button id="logout" class="btn-secondary px-3 py-1.5">Salir</button>
        </div>
      </header>

      <main class="mx-auto max-w-5xl space-y-6 p-4 pb-12">
        <nav class="flex gap-1 rounded-2xl bg-[#E9EBF2] p-1 text-sm font-semibold">
          <button data-tab="resumen" class="flex-1 rounded-xl px-3 py-2 transition">📊 Resumen</button>
          <button data-tab="reportes" class="flex-1 rounded-xl px-3 py-2 transition">📅 Reportes</button>
          <button data-tab="metas" class="flex-1 rounded-xl px-3 py-2 transition">🎯 Metas</button>
        </nav>
        <div id="demo-note" class="hidden rounded-2xl bg-amber-50 p-4 text-sm text-amber-800 ring-1 ring-amber-200">
          ⚠️ Mostrando <b>datos de ejemplo</b>: la API aún no tiene estos endpoints.
          <button id="demo-retry" class="font-semibold underline">Reintentar con la API real</button>
        </div>

        <!-- ============ RESUMEN ============ -->
        <div id="tab-resumen" class="space-y-6">
          <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <!-- Tarjeta principal: mismo degradado oscuro del ícono de la app -->
            <div class="relative overflow-hidden rounded-2xl bg-cashly-fondo p-5 text-white shadow-lg shadow-[#16204A]/20">
              <div class="pointer-events-none absolute -top-10 -right-10 h-28 w-28 rounded-full bg-brand-cian/30 blur-2xl"></div>
              <p class="relative text-xs font-medium tracking-wide text-white/70 uppercase">Total gastado</p>
              <p id="k-total" class="kpi-value relative">–</p>
            </div>
            <div class="panel">
              <p class="kpi-label">Movimientos</p>
              <p id="k-count" class="kpi-value">–</p>
              <p class="text-xs text-error"><span id="k-declined">0</span> declinadas</p>
            </div>
            <div class="panel">
              <p class="kpi-label">💳 Tarjeta</p>
              <p id="k-card" class="kpi-value">–</p>
            </div>
            <div class="panel">
              <p class="kpi-label">💵 Efectivo</p>
              <p id="k-cash" class="kpi-value">–</p>
            </div>
          </section>

          <div class="grid gap-6 lg:grid-cols-3">
            <section class="panel lg:col-span-1">
              <h2 class="panel-title">Por categoría</h2>
              <div id="cats" class="space-y-4"></div>
            </section>

            <!-- Simulador del Atajo -->
            <section class="rounded-2xl bg-cashly-fondo p-5 text-white shadow-lg shadow-[#16204A]/20 lg:col-span-2">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h2 class="font-semibold">📱 Simulador del Atajo de iPhone</h2>
                  <p class="text-xs text-white/60">Hace lo mismo que hará el Atajo al pagar con Apple Pay.</p>
                </div>
                <button id="sim" class="rounded-xl bg-white px-4 py-2 text-sm font-semibold text-[#0E1525] transition hover:bg-white/90">⚡ Simular pago</button>
              </div>
              <pre id="sim-log" class="mt-4 max-h-48 overflow-auto rounded-xl bg-black/30 p-4 text-xs leading-relaxed text-brand-cian">Pulsa el botón para enviar un pago de prueba a /v1/ingest…</pre>
            </section>
          </div>

          <section class="panel">
            <h2 class="panel-title">Registrar gasto manual</h2>
            <form id="tx-form" class="grid gap-3 sm:grid-cols-6">
              <select id="f-type" class="field sm:col-span-1">
                <option value="cash">💵 Efectivo</option>
                <option value="card">💳 Tarjeta</option>
              </select>
              <input id="f-merchant" required placeholder="Comercio" class="field sm:col-span-2" />
              <input id="f-amount" required placeholder="Monto (ej. 25.000)" class="field sm:col-span-1" />
              <select id="f-category" class="field sm:col-span-2"></select>
              <input id="f-card" placeholder="Tarjeta (ej. Visa 4242)" class="field hidden sm:col-span-2" />
              <input id="f-desc" placeholder="Descripción (opcional)" class="field sm:col-span-3" />
              <button class="btn-primary sm:col-span-1">Agregar</button>
            </form>
          </section>

          <section class="overflow-hidden rounded-2xl bg-superficie shadow-[0_1px_3px_rgb(14_21_37/0.05)] ring-1 ring-borde">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-borde p-5">
              <h2 class="font-semibold">Transacciones</h2>
              <div class="flex gap-2">
                <select id="flt-type" class="field-sm">
                  <option value="">Todos los tipos</option>
                  <option value="card">💳 Tarjeta</option>
                  <option value="cash">💵 Efectivo</option>
                </select>
                <select id="flt-status" class="field-sm">
                  <option value="">Todos los estados</option>
                  <option value="approved">Aprobada</option>
                  <option value="pending">Pendiente</option>
                  <option value="declined">Declinada</option>
                  <option value="refunded">Reembolsada</option>
                </select>
              </div>
            </div>
            <ul id="list" class="divide-y divide-borde"></ul>
          </section>
        </div>

        <!-- ============ REPORTES ============ -->
        <div id="tab-reportes" class="hidden space-y-6">
          <section id="r-kpis" class="grid grid-cols-2 gap-3 lg:grid-cols-4"></section>
          <section class="panel">
            <h2 class="mb-6 font-semibold">Gasto diario · últimos 30 días</h2>
            <div id="r-daily-chart"></div>
          </section>
          <div class="grid gap-6 lg:grid-cols-2">
            <section class="panel">
              <h2 class="panel-title">Reporte semanal</h2>
              <div id="r-weekly" class="space-y-4"></div>
            </section>
            <section class="panel">
              <h2 class="panel-title">Por categoría</h2>
              <div id="r-cats" class="space-y-4"></div>
              <h2 class="panel-title mt-8">Top comercios</h2>
              <ol id="r-merch" class="space-y-2.5 text-sm"></ol>
            </section>
          </div>
          <section class="panel">
            <h2 class="panel-title">Detalle por día</h2>
            <div class="max-h-80 overflow-auto"><table id="r-table" class="w-full text-sm"></table></div>
          </section>
        </div>

        <!-- ============ METAS ============ -->
        <div id="tab-metas" class="hidden space-y-6">
          <section class="panel">
            <h2 id="g-title" class="font-semibold">Metas del mes</h2>
            <form id="g-form" class="mt-4 grid gap-3 sm:grid-cols-4">
              <select id="g-cat" class="field"></select>
              <input id="g-limit" required placeholder="Límite mensual (ej. 2.000.000)" class="field sm:col-span-2" />
              <button class="btn-primary">Crear meta</button>
            </form>
          </section>
          <div id="g-list" class="grid gap-4 md:grid-cols-2"></div>
        </div>
      </main>
    </div>

    <!-- Llave de recuperación -->
    <div id="recovery" class="fixed inset-0 z-20 hidden items-center justify-center bg-[#0E1525]/45 p-4 backdrop-blur-sm">
      <div class="animate-aparecer w-full max-w-md space-y-4 rounded-3xl bg-superficie p-7 shadow-2xl ring-1 ring-borde">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-2xl">🔑</span>
        <h2 class="text-lg font-bold">Guarda tu llave de recuperación</h2>
        <p class="text-sm text-texto-2">Es la única forma de recuperar tus datos si olvidas la contraseña. No se vuelve a mostrar.</p>
        <code id="rk" class="block rounded-xl bg-superficie-2 p-4 font-mono text-xs break-all text-brand ring-1 ring-borde"></code>
        <div class="flex gap-2">
          <button id="rk-copy" class="btn-secondary flex-1">Copiar</button>
          <button id="rk-ok" class="btn-primary flex-1 text-sm">Ya la guardé</button>
        </div>
      </div>
    </div>

    <!-- Diálogo de confirmación / entrada de texto (reemplaza confirm() y prompt()) -->
    <dialog id="dlg" class="cashly-dialog m-auto w-[calc(100%-2rem)] max-w-sm rounded-3xl bg-superficie p-0 text-texto shadow-2xl ring-1 ring-borde">
      <form method="dialog" class="space-y-4 p-6">
        <div class="flex items-start gap-3">
          <span id="dlg-icon" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-lg"></span>
          <div class="min-w-0 flex-1">
            <h2 id="dlg-title" class="font-semibold"></h2>
            <p id="dlg-msg" class="mt-1 text-sm text-texto-2"></p>
          </div>
        </div>
        <input id="dlg-input" class="field hidden w-full" />
        <div class="flex gap-2">
          <!-- "Aceptar" va primero en el HTML para que Enter lo active; `order` lo deja a la derecha -->
          <button id="dlg-ok" value="ok" class="btn-primary order-2 flex-1 text-sm">Aceptar</button>
          <button value="cancel" formnovalidate class="btn-secondary order-1 flex-1">Cancelar</button>
        </div>
      </form>
    </dialog>

    <div class="pointer-events-none fixed right-2 bottom-1 z-10 text-[10px] text-texto-3 select-none">v{VERSION}</div>

    <!-- Notificación -->
    <div id="toast" class="fixed inset-x-4 top-4 z-30 hidden cursor-pointer items-center gap-3 rounded-2xl bg-superficie p-3 pr-4 shadow-xl ring-1 ring-borde sm:inset-x-auto sm:right-4 sm:max-w-sm"></div>

    <script>
      import { API_URL } from '../config';
      const $ = (s) => document.querySelector(s);
      const store = {
        get: (k, d = null) => localStorage.getItem(k) ?? d,
        set: (k, v) => localStorage.setItem(k, v),
        del: (k) => localStorage.removeItem(k),
      };
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const CATS = ['comida', 'mercado', 'transporte', 'ocio', 'servicios', 'salud', 'otros'];
      // Colores de la paleta de Cashly para cada categoría (las que no estén aquí usan el azul de marca).
      const CAT_COLOR = {
        comida: 'bg-cat-comida', mercado: 'bg-cat-compras', transporte: 'bg-cat-transporte', ocio: 'bg-cat-ocio',
        servicios: 'bg-brand-cian', salud: 'bg-cat-salud', otros: 'bg-cat-otros',
      };
      const catColor = (c) => CAT_COLOR[c] || 'bg-brand';
      const STATUS = { approved: 'Aprobada', pending: 'Pendiente', declined: 'Declinada', refunded: 'Reembolsada' };
      const STATUS_CLS = {
        approved: 'bg-emerald-50 text-emerald-700', pending: 'bg-amber-50 text-amber-700',
        declined: 'bg-red-50 text-red-600', refunded: 'bg-sky-50 text-sky-700',
      };
      const API = API_URL.replace(/\/+$/, ''); // se configura en src/config.ts
      store.del('apiUrl'); // versiones anteriores guardaban la URL en el navegador
      let mode = 'login';

      function money(n, cur = 'COP') {
        try { return new Intl.NumberFormat('es-CO', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
        catch { return `${n} ${cur}`; }
      }

      // ---------- Notificaciones ----------
      // toast(mensaje, tipo): tipo = 'info' | 'success' | 'warning' | 'error'
      const TOAST = {
        info: { icon: 'i', cls: 'bg-brand/10 text-brand' },
        success: { icon: '✓', cls: 'bg-emerald-50 text-emerald-600' },
        warning: { icon: '!', cls: 'bg-amber-50 text-amber-600' },
        error: { icon: '✕', cls: 'bg-red-50 text-red-600' },
      };
      let toastT;
      function hideToast() { $('#toast').classList.add('hidden'); $('#toast').classList.remove('flex'); }
      function toast(msg, type = 'info') {
        const t = $('#toast'), { icon, cls } = TOAST[type];
        t.innerHTML = `<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold ${cls}">${icon}</span><p class="text-sm">${esc(msg)}</p>`;
        t.classList.remove('hidden', 'animate-aparecer'); t.classList.add('flex');
        void t.offsetWidth; t.classList.add('animate-aparecer'); // reinicia la animación
        clearTimeout(toastT); toastT = setTimeout(hideToast, type === 'error' ? 6000 : 4000);
      }
      $('#toast').onclick = hideToast;

      // ---------- Diálogo (reemplaza confirm y prompt) ----------
      // Devuelve true/false, o el texto escrito (null si cancela) cuando se pide `input`.
      function ask({ title, message = '', ok = 'Aceptar', danger = false, input = null }) {
        const d = $('#dlg'), field = $('#dlg-input');
        $('#dlg-title').textContent = title;
        $('#dlg-msg').textContent = message;
        $('#dlg-icon').textContent = danger ? '🗑' : input ? '✎' : '?';
        $('#dlg-icon').className = `flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-lg ${danger ? 'bg-red-50' : 'bg-brand/10'}`;
        $('#dlg-ok').textContent = ok;
        $('#dlg-ok').className = `${danger ? 'btn-danger' : 'btn-primary'} order-2 flex-1 text-sm`;
        field.classList.toggle('hidden', !input); field.required = !!input;
        field.value = ''; field.placeholder = input?.placeholder || '';
        d.returnValue = '';
        d.showModal();
        (input ? field : $('#dlg-ok')).focus();
        return new Promise((resolve) => d.addEventListener('close', () => {
          const accepted = d.returnValue === 'ok';
          resolve(input ? (accepted && field.value.trim()) || null : accepted);
        }, { once: true }));
      }

      // ---------- Cliente de la API ----------
      async function call(method, path, body, o = {}) {
        const token = o.token ?? (o.auth === false ? null : store.get('at'));
        let res;
        try {
          res = await fetch(API + path, {
            method,
            headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: 'Bearer ' + token } : {}) },
            body: body ? JSON.stringify(body) : undefined,
          });
        } catch {
          throw new Error(`No se pudo conectar con ${API}. ¿Está corriendo la API? ¿CORS_ORIGINS incluye ${location.origin}?`);
        }
        if (res.status === 401 && o.auth !== false && !o.token && o.retry !== false && store.get('rt') && (await refresh())) {
          return call(method, path, body, { ...o, retry: false });
        }
        const text = await res.text();
        let data = null;
        try { data = text ? JSON.parse(text) : null; } catch { data = { error: text }; }
        if (res.status === 429) {
          // La API responde { error, retryAfterSec }: límite general de /v1/auth/* o espera entre reenvíos del código.
          const retryAfterSec = Number(data?.retryAfterSec ?? res.headers.get('RateLimit-Reset')) || 0;
          const generic = !data?.error || data.error.startsWith('Demasiados intentos');
          const msg = generic && retryAfterSec >= 60
            ? `Demasiados intentos. Espera ${Math.ceil(retryAfterSec / 60)} min y vuelve a intentar.`
            : data?.error || 'Demasiados intentos. Espera unos minutos y vuelve a intentar.';
          throw Object.assign(new Error(msg), { status: 429, data, retryAfterSec });
        }
        if (!res.ok) {
          const det = data?.details?.map((d) => `${d.field}: ${d.message}`).join(' · ');
          throw Object.assign(new Error(det || data?.error || `Error ${res.status}`), { status: res.status, data });
        }
        return data;
      }

      function setSession(r) {
        store.set('at', r.accessToken);
        store.set('rt', r.refreshToken);
      }
      async function refresh() {
        try {
          setSession(await call('POST', '/v1/auth/refresh', { refreshToken: store.get('rt') }, { auth: false }));
          return true;
        } catch {
          clearSession(); showAuth();
          toast('Tu sesión venció. Vuelve a iniciar sesión.', 'warning');
          return false;
        }
      }
      function clearSession() { ['at', 'rt', 'it'].forEach(store.del); }

      // ---------- Pantallas ----------
      function showAuth() {
        $('#app').classList.add('hidden');
        $('#auth').classList.remove('hidden'); $('#auth').classList.add('grid');
        showEmailVerify(null);
        showMfa(null);
      }
      function showApp() {
        $('#auth').classList.add('hidden'); $('#auth').classList.remove('grid');
        $('#app').classList.remove('hidden');
        showTab('resumen');
        load();
      }

      const TITLE = { login: 'Hola de nuevo 👋', register: 'Crea tu cuenta', recover: 'Recupera tu cuenta' };
      const SUB = { login: 'Inicia sesión para ver tus gastos', register: 'Empieza a registrar tus gastos en segundos', recover: 'Recupera tu cuenta con la llave de recuperación' };
      function setMode(m) {
        mode = m;
        const reg = m === 'register', rec = m === 'recover';
        $('#auth-form h1').textContent = TITLE[m];
        $('#auth-sub').textContent = SUB[m];
        $('#a-submit').textContent = reg ? 'Crear cuenta' : rec ? 'Recuperar cuenta' : 'Entrar';
        $('#a-toggle').textContent = m === 'login' ? '¿No tienes cuenta? Crear una' : '¿Ya tienes cuenta? Inicia sesión';
        $('#a-forgot').classList.toggle('hidden', m !== 'login');
        $('#a-rk-field').classList.toggle('hidden', !rec); $('#a-rk').required = rec;
        $('#a-pass').placeholder = rec ? 'Nueva contraseña (mínimo 10 caracteres)' : 'Contraseña (mínimo 10 caracteres)';
      }
      $('#a-toggle').onclick = () => setMode(mode === 'login' ? 'register' : 'login');
      $('#a-forgot').onclick = () => setMode('recover');
      $('#a-pass-toggle').onclick = () => {
        const p = $('#a-pass'), show = p.type === 'password';
        p.type = show ? 'text' : 'password';
        $('#a-pass-toggle').title = show ? 'Ocultar contraseña' : 'Mostrar contraseña';
      };

      // ---------- MFA (Microsoft / Google Authenticator) ----------
      // El mfaToken vive solo en memoria: dura 10 min, es de un solo uso y no sirve como sesión.
      let mfa = null; // { token, enrolling }
      function showMfa(r) {
        mfa = r && { token: r.mfaToken, enrolling: !!r.mfaSetupRequired };
        if (mfa) $('#email-form').classList.add('hidden');
        $('#auth-form').classList.toggle('hidden', !!mfa);
        $('#mfa-form').classList.toggle('hidden', !mfa);
        $('#mfa-form').reset();
        if (!mfa) return;
        $('#mfa-setup').classList.toggle('hidden', !mfa.enrolling);
        $('#mfa-sub').textContent = mfa.enrolling
          ? 'Para proteger tu cuenta, vincula una app de autenticación.'
          : 'Escribe el código de 6 dígitos de tu app Authenticator.';
        if (mfa.enrolling) { $('#mfa-qr').src = r.mfaSetup.qrCode; $('#mfa-secret').textContent = r.mfaSetup.secret; }
        $('#mfa-code').focus();
      }
      $('#mfa-form').onsubmit = async (e) => {
        e.preventDefault();
        const code = $('#mfa-code').value.replace(/\D/g, ''); // quita espacios u otros caracteres al pegar
        if (code.length !== 6) return toast('El código debe tener 6 dígitos', 'warning');
        const path = mfa.enrolling ? '/v1/auth/mfa/setup/confirm' : '/v1/auth/login/mfa';
        try {
          setSession(await call('POST', path, { mfaToken: mfa.token, code }, { auth: false }));
          $('#a-pass').value = $('#a-rk').value = '';
          showMfa(null); setMode('login'); showApp();
        } catch (err) {
          toast(err.message, 'error');
          // mfaToken vencido o anulado tras 5 intentos: hay que volver a poner la contraseña.
          if (err.message.startsWith('mfaToken')) showMfa(null);
          else { $('#mfa-code').value = ''; $('#mfa-code').focus(); }
        }
      };
      $('#mfa-cancel').onclick = () => showMfa(null);
      $('#mfa-secret-copy').onclick = () => navigator.clipboard.writeText($('#mfa-secret').textContent).then(() => toast('Clave copiada', 'success'));

      // ---------- Verificación del correo ----------
      // Las credenciales quedan solo en memoria para hacer login automático al verificar el correo.
      let ev = null; // { email, password, sentAt }
      let resendTimer;
      function showEmailVerify(v, { emailSent = true, warn = '' } = {}) {
        ev = v;
        clearInterval(resendTimer);
        $('#email-form').classList.toggle('hidden', !ev);
        $('#auth-form').classList.toggle('hidden', !!ev);
        $('#email-form').reset();
        if (!ev) return;
        $('#mfa-form').classList.add('hidden');
        $('#ev-email').textContent = ev.email;
        setEvWarn(warn || (emailSent ? '' : 'No pudimos enviar el correo. Pulsa “Reenviar código”.'));
        // La API exige esperar 60 s entre envíos; si el correo no salió se puede reenviar ya.
        startResendCooldown(emailSent && ev.sentAt ? 60 - Math.floor((Date.now() - ev.sentAt) / 1000) : 0);
        $('#ev-code').focus();
      }
      function setEvWarn(msg) {
        $('#ev-warn').textContent = msg;
        $('#ev-warn').classList.toggle('hidden', !msg);
      }
      function startResendCooldown(sec) {
        clearInterval(resendTimer);
        const btn = $('#ev-resend');
        let left = Math.max(0, Math.ceil(sec));
        const tick = () => {
          btn.disabled = left > 0;
          btn.textContent = left > 0 ? `Reenviar código (${left} s)` : 'Reenviar código';
          if (left-- <= 0) clearInterval(resendTimer);
        };
        tick();
        if (left >= 0) resendTimer = setInterval(tick, 1000);
      }
      $('#email-form').onsubmit = async (e) => {
        e.preventDefault();
        const code = $('#ev-code').value.replace(/\D/g, '');
        if (code.length !== 6) return toast('El código debe tener 6 dígitos', 'warning');
        $('#ev-submit').disabled = true;
        try {
          await call('POST', '/v1/auth/verify-email', { email: ev.email, code }, { auth: false });
          toast('Correo verificado', 'success');
          const { email, password } = ev;
          showEmailVerify(null);
          // Con el correo verificado, el login devuelve el QR (primera vez) o pide el código del Authenticator.
          if (password) {
            try { showMfa(await call('POST', '/v1/auth/login', { email, password }, { auth: false })); }
            catch (err) { toast(err.message, 'error'); setMode('login'); }
          } else setMode('login');
        } catch (err) {
          $('#ev-code').value = ''; $('#ev-code').focus();
          if (err.status === 401 && err.data?.attemptsLeft != null) {
            const n = err.data.attemptsLeft;
            if (n > 0) toast(`Código incorrecto. Te quedan ${n} intento${n === 1 ? '' : 's'}.`, 'error');
            else { toast('Código incorrecto.', 'error'); setEvWarn('Agotaste los intentos de este código. Pide uno nuevo con “Reenviar código”.'); }
          } else {
            toast(err.message, 'error');
            // Código vencido, sin intentos o inexistente: hay que pedir uno nuevo.
            if (err.status === 400 && /pide uno nuevo|pide un código nuevo/.test(err.message)) setEvWarn(err.message);
          }
        } finally { $('#ev-submit').disabled = false; }
      };
      $('#ev-resend').onclick = async () => {
        $('#ev-resend').disabled = true;
        try {
          await call('POST', '/v1/auth/resend-code', { email: ev.email }, { auth: false });
          ev.sentAt = Date.now();
          setEvWarn('');
          toast('Te enviamos un código nuevo. El anterior ya no sirve.', 'success');
          startResendCooldown(60);
          $('#ev-code').focus();
        } catch (err) {
          toast(err.message, 'error');
          startResendCooldown(err.status === 429 ? err.retryAfterSec || 60 : 0);
        }
      };
      $('#ev-cancel').onclick = () => showEmailVerify(null);

      $('#auth-form').onsubmit = async (e) => {
        e.preventDefault();
        const email = $('#a-email').value.trim(), pass = $('#a-pass').value;
        const body = mode === 'recover' ? { email, recoveryKey: $('#a-rk').value.trim(), newPassword: pass } : { email, password: pass };
        try {
          // Ninguno entrega sesión. Registro → código al correo; login/recover → mfaToken (y QR si toca).
          const r = await call('POST', '/v1/auth/' + mode, body, { auth: false });
          pendingAuth = { r, email, password: pass, sentAt: mode === 'register' ? Date.now() : null };
          if (r.recoveryKey) {
            $('#rk').textContent = r.recoveryKey;
            $('#recovery').classList.remove('hidden'); $('#recovery').classList.add('flex');
          } else continueAuth();
        } catch (err) {
          // Contraseña correcta pero correo sin verificar: pedir el código del correo.
          if (err.status === 403 && err.data?.emailVerificationRequired) {
            showEmailVerify({ email, password: pass, sentAt: null },
              { warn: 'Tu correo aún no está verificado. Escribe el código que te enviamos o pide uno nuevo.' });
          } else toast(err.message, 'error');
        }
      };
      let pendingAuth = null; // respuesta guardada mientras el usuario anota la llave de recuperación
      function continueAuth() {
        const { r, email, password, sentAt } = pendingAuth; pendingAuth = null;
        if (r.emailVerificationRequired) {
          showEmailVerify({ email, password, sentAt }, {
            emailSent: r.emailSent !== false,
            warn: sentAt ? '' : 'Tu correo aún no está verificado. Escribe el código que te enviamos o pide uno nuevo.',
          });
        } else showMfa(r);
      }
      $('#rk-copy').onclick = () => navigator.clipboard.writeText($('#rk').textContent).then(() => toast('Llave copiada', 'success'));
      $('#rk-ok').onclick = () => {
        $('#recovery').classList.add('hidden'); $('#recovery').classList.remove('flex');
        continueAuth();
      };

      $('#logout').onclick = async () => {
        try { await call('POST', '/v1/auth/logout', {}); } catch {}
        clearSession(); showAuth();
      };

      // ---------- Barras horizontales (categorías y semanas) ----------
      const barRow = (label, value, width, color) => `
        <div>
          <div class="mb-1.5 flex justify-between gap-2 text-sm"><span>${label}</span><span class="tabular-nums text-texto-2">${value}</span></div>
          <div class="bar-track"><div class="h-2 rounded-full ${color}" style="width:${width}%"></div></div>
        </div>`;
      const catLabel = (c) => `<span class="inline-flex items-center gap-2 capitalize"><span class="h-2 w-2 rounded-full ${catColor(c)}"></span>${esc(c.replace('_', ' '))}</span>`;
      function categoryBars(totals, emptyText) {
        const entries = Object.entries(totals).sort((a, b) => b[1] - a[1]);
        const max = entries[0]?.[1] || 1;
        return entries.map(([c, v]) => barRow(catLabel(c), money(v), Math.max(4, (v / max) * 100), 'bg-brand')).join('')
          || `<p class="empty">${emptyText}</p>`;
      }

      // ---------- Datos ----------
      async function load() {
        const qs = new URLSearchParams({ limit: '200' });
        if ($('#flt-type').value) qs.set('type', $('#flt-type').value);
        if ($('#flt-status').value) qs.set('status', $('#flt-status').value);
        try {
          const [list, sum] = await Promise.all([
            call('GET', '/v1/transactions?' + qs), call('GET', '/v1/transactions/summary'),
          ]);
          renderSummary(sum); renderList(list.items);
        } catch (err) { toast(err.message, 'error'); }
      }

      function renderSummary(s) {
        $('#k-total').textContent = money(s.total);
        $('#k-count').textContent = s.count;
        $('#k-declined').textContent = s.declined_count;
        $('#k-card').textContent = money(s.by_type.card || 0);
        $('#k-cash').textContent = money(s.by_type.cash || 0);
        $('#cats').innerHTML = categoryBars(s.by_category, 'Aún no hay gastos.');
      }

      function renderList(items) {
        if (!items.length) { $('#list').innerHTML = '<li class="p-10 text-center text-sm text-texto-3">No hay transacciones. Agrega una o simula un pago.</li>'; return; }
        $('#list').innerHTML = items.map((t) => {
          const cats = CATS.includes(t.category) || !t.category ? CATS : [...CATS, t.category];
          const src = t.source === 'ios-shortcut' ? '📱 Atajo iOS' : t.source === 'manual' ? '✍️ Manual' : esc(t.source);
          const when = new Date(t.occurred_at).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' });
          return `
          <li class="flex flex-wrap items-center gap-3 px-5 py-3.5 transition hover:bg-superficie-2" data-id="${t.id}">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-superficie-2 text-lg ring-1 ring-borde">${t.type === 'cash' ? '💵' : '💳'}</div>
            <div class="min-w-0 flex-1">
              <p class="truncate font-semibold">${esc(t.merchant)}</p>
              <p class="text-xs text-texto-3">${when}${t.card ? ' · ' + esc(t.card) : ''} · ${src}</p>
              ${t.description ? `<p class="truncate text-xs text-texto-2">${esc(t.description)}</p>` : ''}
            </div>
            <p class="font-bold tabular-nums ${t.status === 'declined' ? 'text-texto-3 line-through' : ''}">${money(t.amount, t.currency)}</p>
            <select data-act="category" class="field-sm capitalize">
              <option value="">sin categoría</option>
              ${cats.map((c) => `<option value="${esc(c)}" ${t.category === c ? 'selected' : ''}>${esc(c)}</option>`).join('')}
            </select>
            <select data-act="status" class="rounded-full border-0 px-2.5 py-1 text-xs font-semibold outline-none ${STATUS_CLS[t.status] || ''}">
              ${Object.entries(STATUS).map(([k, v]) => `<option value="${k}" ${t.status === k ? 'selected' : ''}>${v}</option>`).join('')}
            </select>
            <button data-act="delete" class="rounded-lg p-1.5 text-texto-3 transition hover:bg-red-50 hover:text-error" title="Borrar">✕</button>
          </li>`;
        }).join('');
      }

      $('#list').onchange = async (e) => {
        const act = e.target.dataset.act; if (!act) return;
        const id = e.target.closest('li').dataset.id;
        try {
          await call('PATCH', '/v1/transactions/' + id, act === 'status' ? { status: e.target.value } : { category: e.target.value || null });
          toast(act === 'status' ? 'Estado actualizado' : 'Categoría actualizada', 'success');
          load();
        } catch (err) { toast(err.message, 'error'); }
      };
      $('#list').onclick = async (e) => {
        if (e.target.dataset.act !== 'delete') return;
        const id = e.target.closest('li').dataset.id;
        if (!(await ask({ title: '¿Borrar esta transacción?', message: 'Esta acción no se puede deshacer.', ok: 'Borrar', danger: true }))) return;
        try { await call('DELETE', '/v1/transactions/' + id); toast('Transacción borrada', 'success'); load(); }
        catch (err) { toast(err.message, 'error'); }
      };
      $('#flt-type').onchange = $('#flt-status').onchange = load;

      // ---------- Formulario manual ----------
      $('#f-category').innerHTML = '<option value="">Categoría</option>' + CATS.map((c) => `<option value="${c}" class="capitalize">${c}</option>`).join('');
      $('#f-type').onchange = () => $('#f-card').classList.toggle('hidden', $('#f-type').value === 'cash');
      $('#tx-form').onsubmit = async (e) => {
        e.preventDefault();
        const type = $('#f-type').value;
        const body = { type, merchant: $('#f-merchant').value, amount: $('#f-amount').value };
        if ($('#f-category').value) body.category = $('#f-category').value;
        if ($('#f-desc').value) body.description = $('#f-desc').value;
        if (type === 'card' && $('#f-card').value) body.card = $('#f-card').value;
        try {
          await call('POST', '/v1/transactions', body);
          e.target.reset(); $('#f-card').classList.add('hidden');
          toast('Gasto agregado', 'success'); load();
        } catch (err) { toast(err.message, 'error'); }
      };

      // ---------- Simulador del Atajo de iOS ----------
      const SIM = [
        { merchant: 'Rappi', amount: '$25.000,00', card: 'Visa 4242' },
        { merchant: 'Éxito', amount: '$87.450,00', card: 'Mastercard 1881' },
        { merchant: 'Uber', amount: '$18.300', card: 'Visa 4242' },
        { merchant: 'Netflix', amount: '$39.900', card: 'Visa 4242', status: 'declined' },
        { merchant: 'Starbucks', amount: 'COP 14,500.00', card: 'Amex 0005' },
        { merchant: 'Droguería Cruz Verde', amount: '$52.000,00', card: 'Mastercard 1881' },
      ];
      async function ensureIngestToken(force = false) {
        if (!force && store.get('it')) return store.get('it');
        const r = await call('POST', '/v1/ingest-tokens', { label: 'Simulador web' });
        store.set('it', r.token);
        return r.token;
      }
      $('#sim').onclick = async () => {
        const p = { ...SIM[Math.floor(Math.random() * SIM.length)], date: new Date().toISOString() };
        const log = $('#sim-log');
        try {
          let tok = await ensureIngestToken();
          const show = (extra) => (log.textContent =
            `POST ${API}/v1/ingest\nAuthorization: Bearer ${tok.slice(0, 9)}…\n\n${JSON.stringify(p, null, 2)}\n\n${extra}`);
          show('Enviando…');
          let res;
          try { res = await call('POST', '/v1/ingest', p, { token: tok }); }
          catch (err) {
            if (err.status !== 401) throw err;
            tok = await ensureIngestToken(true); // token revocado: crear otro
            res = await call('POST', '/v1/ingest', p, { token: tok });
          }
          show(`→ 201 ${JSON.stringify(res)}`);
          toast(`Pago de ${p.merchant} registrado`, 'success');
          load();
        } catch (err) { log.textContent = 'Error: ' + err.message; toast(err.message, 'error'); }
      };

      // ---------- Pestañas, Reportes y Metas ----------
      const TZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const iso = (d) => d.toLocaleDateString('en-CA'); // YYYY-MM-DD en hora local
      const fmtDay = (d) => new Date(d + 'T12:00:00').toLocaleDateString('es-CO', { weekday: 'short', day: 'numeric', month: 'short' });
      const fmtShort = (d) => new Date(d + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
      let DEMO = false; // true = la API no tiene los endpoints nuevos: se muestran datos de ejemplo

      document.querySelectorAll('[data-tab]').forEach((b) => (b.onclick = () => showTab(b.dataset.tab)));
      function showTab(t) {
        ['resumen', 'reportes', 'metas'].forEach((x) => $('#tab-' + x).classList.toggle('hidden', x !== t));
        document.querySelectorAll('[data-tab]').forEach((b) => {
          const on = b.dataset.tab === t;
          b.classList.toggle('bg-superficie', on); b.classList.toggle('text-brand', on); b.classList.toggle('shadow-sm', on);
          b.classList.toggle('text-texto-2', !on); b.classList.toggle('hover:text-texto', !on);
        });
        if (t === 'reportes') loadReports();
        if (t === 'metas') loadGoals();
      }
      // Pide a la API real; si el endpoint no existe (404) usa datos de ejemplo.
      async function getNew(path, demoFn) {
        if (!DEMO) {
          try { const r = await call('GET', path); $('#demo-note').classList.add('hidden'); return r; }
          catch (e) { if (e.status !== 404) throw e; DEMO = true; }
        }
        $('#demo-note').classList.remove('hidden');
        return demoFn();
      }
      $('#demo-retry').onclick = () => { DEMO = false; $('#tab-metas').classList.contains('hidden') ? loadReports() : loadGoals(); };

      // ----- Datos de ejemplo (misma forma que devolverá la API) -----
      const rnd = (i) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };
      function sampleDays(n = 56) {
        const out = [], today = new Date(); today.setHours(12, 0, 0, 0);
        for (let i = n - 1; i >= 0; i--) {
          const d = new Date(today); d.setDate(d.getDate() - i);
          const r = rnd(d.getFullYear() * 372 + d.getMonth() * 31 + d.getDate());
          const by = {};
          if (r > 0.15) ['comida', 'mercado', 'transporte', 'ocio', 'servicios'].forEach((c, k) => (by[c] = Math.round((15000 + r * 110000) * [0.35, 0.25, 0.2, 0.12, 0.08][k] / 1000) * 1000));
          const total = Object.values(by).reduce((a, b) => a + b, 0), card_ = Math.round(total * 0.8 / 1000) * 1000;
          out.push({ date: iso(d), total, count: total ? 1 + Math.floor(r * 4) : 0, by_category: by, by_type: { card: card_, cash: total - card_ } });
        }
        return out;
      }
      function sampleDaily() {
        const days = sampleDays().slice(-30), total = days.reduce((a, x) => a + x.total, 0);
        const top_merchants = [['Rappi', 0.22], ['Éxito', 0.18], ['Uber', 0.12], ['Starbucks', 0.08], ['Netflix', 0.05]]
          .map(([merchant, p]) => ({ merchant, total: Math.round(total * p / 1000) * 1000, count: Math.round(days.length * p * 0.8) }));
        return { tz: TZ, days, summary: { total, avg_per_day: Math.round(total / days.length), max_day: days.reduce((a, x) => (x.total > a.total ? x : a)), zero_days: days.filter((x) => !x.total).length, top_merchants } };
      }
      function sampleWeekly() {
        const weeks = {};
        sampleDays().forEach((x) => {
          const d = new Date(x.date + 'T12:00:00'); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); // lunes
          const w = (weeks[iso(d)] ||= { start: iso(d), total: 0, count: 0, days: 0 });
          w.total += x.total; w.count += x.count; w.days++;
        });
        const list = Object.values(weeks).sort((a, b) => (a.start < b.start ? -1 : 1)).slice(-8);
        list.forEach((w, i) => {
          const e = new Date(w.start + 'T12:00:00'); e.setDate(e.getDate() + 6);
          w.end = iso(e); w.avg_per_day = Math.round(w.total / w.days);
          w.change_pct = i && list[i - 1].total ? Math.round(((w.total - list[i - 1].total) / list[i - 1].total) * 100) : null;
        });
        return { tz: TZ, weeks: list };
      }
      let demoGoals = [{ id: 'd1', category: null, limit: 2500000 }, { id: 'd2', category: 'comida', limit: 600000 }];
      const parseLimit = (v) => Number(String(v).replace(/[^\d]/g, ''));
      function demoProgress() {
        const m = iso(new Date()).slice(0, 7), md = sampleDays().filter((x) => x.date.startsWith(m));
        const now = new Date(), dim = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate(), el = now.getDate(), left = dim - el + 1;
        const goals = demoGoals.map((g) => {
          const spent = md.reduce((a, x) => a + (g.category ? x.by_category[g.category] || 0 : x.total), 0), remaining = g.limit - spent, percent = Math.round((spent / g.limit) * 100);
          return { id: g.id, category: g.category, limit: g.limit, spent, remaining, percent, status: percent >= 100 ? 'exceeded' : percent >= 80 ? 'warning' : 'ok', daily_allowance: remaining > 0 ? Math.round(remaining / left) : 0, projected: Math.round((spent / el) * dim) };
        });
        return { month: m, days_in_month: dim, days_elapsed: el, days_left: left, goals };
      }

      // ----- Reportes -----
      async function loadReports() {
        const q = '?tz=' + encodeURIComponent(TZ);
        try {
          const [d, w] = await Promise.all([getNew('/v1/reports/daily' + q, sampleDaily), getNew('/v1/reports/weekly' + q + '&weeks=8', sampleWeekly)]);
          renderReports(d, w);
        } catch (e) { toast(e.message, 'error'); }
      }
      function renderReports(d, w) {
        const s = d.summary, max = Math.max(...d.days.map((x) => x.total), 1);
        const kpi = (l, v, sub = '') => `<div class="panel"><p class="kpi-label">${l}</p><p class="mt-1 text-xl font-bold tabular-nums">${v}</p><p class="text-xs text-texto-3">${sub}</p></div>`;
        $('#r-kpis').innerHTML = kpi('Total del período', money(s.total), d.days.length + ' días') + kpi('Promedio diario', money(s.avg_per_day))
          + kpi('Día de mayor gasto', money(s.max_day.total), fmtDay(s.max_day.date)) + kpi('Días sin gasto', s.zero_days);

        // Barras del día: el de mayor gasto va con el degradado de marca.
        $('#r-daily-chart').innerHTML = `
          <div class="relative flex h-48 items-end gap-0.5 border-b border-borde">
            <div class="absolute inset-x-0 border-t border-dashed border-amber-400" style="bottom:${(s.avg_per_day / max) * 100}%"><span class="absolute -top-4 right-0 rounded bg-amber-50 px-1 text-[10px] font-medium text-amber-700">promedio ${money(s.avg_per_day)}</span></div>
            ${d.days.map((x) => `<div class="flex-1 rounded-t-md transition hover:opacity-80 ${x.total === s.max_day.total ? 'bg-brand' : 'bg-brand/30'}" style="height:${x.total ? Math.max(2, (x.total / max) * 100) : 0}%" title="${fmtDay(x.date)}: ${money(x.total)}"></div>`).join('')}
          </div>
          <div class="mt-1.5 flex gap-0.5 text-[9px] text-texto-3">${d.days.map((x) => `<span class="flex-1 text-center">${+x.date.slice(8)}</span>`).join('')}</div>`;

        const wmax = Math.max(...w.weeks.map((x) => x.total), 1);
        $('#r-weekly').innerHTML = w.weeks.slice().reverse().map((x) => {
          const c = x.change_pct, arrow = c == null ? '' : `<span class="ml-1 text-xs font-semibold ${c > 0 ? 'text-red-600' : 'text-emerald-600'}">${c > 0 ? '▲' : '▼'} ${Math.abs(c)}%</span>`;
          return `<div>${barRow(`${fmtShort(x.start)} – ${fmtShort(x.end)}`, money(x.total) + arrow, Math.max(2, (x.total / wmax) * 100), 'bg-brand/70')}
            <p class="mt-1 text-xs text-texto-3">${x.count} movimientos · ${money(x.avg_per_day)} por día</p></div>`;
        }).join('');

        const cats = {};
        d.days.forEach((x) => Object.entries(x.by_category).forEach(([c, v]) => (cats[c] = (cats[c] || 0) + v)));
        $('#r-cats').innerHTML = categoryBars(cats, 'Sin datos.');
        $('#r-merch').innerHTML = s.top_merchants.map((m, i) => `
          <li class="flex items-center justify-between gap-2">
            <span class="flex items-center gap-3"><span class="flex h-6 w-6 items-center justify-center rounded-lg bg-brand/10 text-xs font-bold text-brand">${i + 1}</span>${esc(m.merchant)} <span class="text-xs text-texto-3">(${m.count})</span></span>
            <span class="font-semibold tabular-nums">${money(m.total)}</span>
          </li>`).join('') || '<li class="empty">Sin datos.</li>';

        $('#r-table').innerHTML = '<thead class="sticky top-0 bg-superficie text-left text-xs text-texto-2 uppercase"><tr><th class="py-2 font-medium">Día</th><th class="font-medium">Mov.</th><th class="font-medium">Categoría principal</th><th class="text-right font-medium">Total</th></tr></thead><tbody class="divide-y divide-borde">'
          + d.days.slice().reverse().map((x) => {
            const top = Object.entries(x.by_category).sort((a, b) => b[1] - a[1])[0];
            return `<tr class="${x.total ? '' : 'text-texto-3'}"><td class="py-2.5">${fmtDay(x.date)}</td><td>${x.count}</td><td>${top ? catLabel(top[0]) : '—'}</td><td class="text-right font-semibold tabular-nums">${money(x.total)}</td></tr>`;
          }).join('') + '</tbody>';
      }

      // ----- Metas -----
      $('#g-cat').innerHTML = '<option value="">Total del mes</option>' + CATS.map((c) => `<option value="${c}">${c}</option>`).join('');
      async function loadGoals() {
        try { renderGoals(await getNew('/v1/goals/progress?tz=' + encodeURIComponent(TZ), demoProgress)); } catch (e) { toast(e.message, 'error'); }
      }
      function renderGoals(p) {
        const mes = new Date(p.month + '-15').toLocaleDateString('es-CO', { month: 'long', year: 'numeric' });
        $('#g-title').textContent = `Metas de ${mes} · faltan ${p.days_left} días`;
        const COL = { ok: 'bg-brand', warning: 'bg-amber-400', exceeded: 'bg-error' };
        $('#g-list').innerHTML = p.goals.map((g) => `
          <div class="panel" data-id="${g.id}">
            <div class="flex items-center justify-between">
              <h3 class="flex items-center gap-2 font-semibold"><span class="h-2.5 w-2.5 rounded-full ${g.category ? catColor(g.category) : 'bg-brand'}"></span>${g.category ? esc(g.category.charAt(0).toUpperCase() + g.category.slice(1)) : 'Total del mes'}</h3>
              <div class="flex gap-1 text-xs">
                <button data-g="edit" class="rounded-lg px-2 py-1 text-texto-2 transition hover:bg-superficie-2 hover:text-texto">Editar</button>
                <button data-g="del" class="rounded-lg px-2 py-1 text-error transition hover:bg-red-50">Borrar</button>
              </div>
            </div>
            <p class="mt-3 text-3xl font-bold tabular-nums ${g.remaining < 0 ? 'text-error' : ''}">${money(Math.abs(g.remaining))}</p>
            <p class="text-xs text-texto-2">${g.remaining >= 0 ? 'te quedan' : 'te pasaste'} · meta ${money(g.limit)}</p>
            <div class="mt-4 h-3 overflow-hidden rounded-full bg-[#EEF0F6]"><div class="h-3 rounded-full ${COL[g.status]}" style="width:${Math.min(100, g.percent)}%"></div></div>
            <p class="mt-1.5 text-xs text-texto-2">${g.percent}% usado · llevas ${money(g.spent)}</p>
            <ul class="mt-4 space-y-1 text-sm text-texto-2">
              <li>📅 ${g.remaining > 0 ? `Puedes gastar <b class="text-texto">${money(g.daily_allowance)}</b> por día` : 'Ya no queda presupuesto este mes'}</li>
              <li class="${g.projected > g.limit ? 'text-error' : ''}">📈 A este ritmo terminarías en <b class="${g.projected > g.limit ? '' : 'text-texto'}">${money(g.projected)}</b></li>
            </ul>
          </div>`).join('') || '<p class="empty">Aún no tienes metas. Crea la primera arriba.</p>';
      }
      $('#g-form').onsubmit = async (e) => {
        e.preventDefault();
        const body = { category: $('#g-cat').value || null, limit: $('#g-limit').value };
        try {
          if (DEMO) demoGoals.push({ id: 'd' + Date.now(), category: body.category, limit: parseLimit(body.limit) });
          else await call('POST', '/v1/goals', body);
          e.target.reset(); toast('Meta creada', 'success'); loadGoals();
        } catch (err) { toast(err.message, 'error'); }
      };
      $('#g-list').onclick = async (e) => {
        const a = e.target.dataset.g; if (!a) return;
        const id = e.target.closest('[data-id]').dataset.id;
        try {
          if (a === 'del') {
            if (!(await ask({ title: '¿Borrar esta meta?', message: 'Dejarás de ver su progreso este mes.', ok: 'Borrar', danger: true }))) return;
            if (DEMO) demoGoals = demoGoals.filter((g) => g.id !== id); else await call('DELETE', '/v1/goals/' + id);
            toast('Meta borrada', 'success');
          } else {
            const v = await ask({ title: 'Nuevo límite mensual', ok: 'Guardar', input: { placeholder: 'Ej. 2.000.000' } }); if (!v) return;
            if (DEMO) demoGoals.find((g) => g.id === id).limit = parseLimit(v); else await call('PATCH', '/v1/goals/' + id, { limit: v });
            toast('Límite actualizado', 'success');
          }
          loadGoals();
        } catch (err) { toast(err.message, 'error'); }
      };

      // ---------- Arranque ----------
      store.get('at') ? showApp() : showAuth();
    </script>
  </body>
</html>
